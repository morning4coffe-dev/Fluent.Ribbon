<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <RootNamespace>FluentUno.UITests</RootNamespace>
    <AssemblyName>Fluent.Ribbon.Uno.UITests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseWpf>false</UseWpf>
    <UseWindowsForms>false</UseWindowsForms>
    <SignAssembly>false</SignAssembly>
    <PublicSign>false</PublicSign>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Remove="GitVersion.MsBuild" />
    <PackageReference Remove="JetBrains.Annotations" />
    <PackageReference Remove="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Remove="StyleCop.Analyzers" />
    <PackageReference Remove="WpfAnalyzers" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Fluent.Ribbon.Uno.Showcase\Fluent.Ribbon.Uno.Showcase\ShowcaseDiagnosticOptions.cs"
             Link="ShowcaseDiagnosticOptions.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Shared\GlobalAssemblyInfo.cs" />
    <None Remove="$(MSBuildThisFileDirectory)..\..\Shared\GlobalAssemblyInfo.cs" />
  </ItemGroup>
</Project>
