+
+	internal override UIAccessibilityContainerType GetNativeAccessibilityContainerType()
+		=> AutomationConfiguration.IsAccessibilityEnabled && IsControlElement()
+			&& IsNativeAccessibilityVisible(Owner) && IsNativeAccessibilityContainer()
+			? UIAccessibilityContainerType.SemanticGroup
+			: UIAccessibilityContainerType.None;
+
+	internal override NSObject[] GetNativeAccessibilityChildren()
+	{
+		if (!AutomationConfiguration.IsAccessibilityEnabled || !IsControlElement()
+			|| !IsNativeAccessibilityVisible(Owner) || !IsNativeAccessibilityContainer())
+		{
+			return null;
+		}
+
+		var children = new List<NSObject>();
+		var visited = new HashSet<AutomationPeer>();
+		AddNativeAccessibilityChildren(this, children, visited);
+		return children.ToArray();
+	}
+
+	private bool IsNativeAccessibilityContainer()
+	{
+		if (GetPattern(PatternInterface.Invoke) is IInvokeProvider
+			|| GetPattern(PatternInterface.Toggle) is IToggleProvider
+			|| GetPattern(PatternInterface.SelectionItem) is ISelectionItemProvider
+			|| GetPattern(PatternInterface.Value) is IValueProvider
+			|| GetPattern(PatternInterface.RangeValue) is IRangeValueProvider)
+		{
+			return false;
+		}
+
+		if (GetPattern(PatternInterface.ExpandCollapse) is IExpandCollapseProvider expansion
+			&& expansion.ExpandCollapseState == ExpandCollapseState.Collapsed)
+		{
+			return false;
+		}
+
+		return GetChildren() is { Count: > 0 };
+	}
+
+	private static void AddNativeAccessibilityChildren(
+		AutomationPeer parent,
+		List<NSObject> children,
+		HashSet<AutomationPeer> visited)
+	{
+		if (!visited.Add(parent) || parent.GetChildren() is not { } peers)
+		{
+			return;
+		}
+
+		foreach (var peer in peers)
+		{
+			if (visited.Contains(peer)
+				|| peer is FrameworkElementAutomationPeer frameworkPeer && !IsNativeAccessibilityVisible(frameworkPeer.Owner))
+			{
+				continue;
+			}
+
+			if (peer.IsControlElement() && peer is FrameworkElementAutomationPeer { Owner: UIView view })
+			{
+				visited.Add(peer);
+				if (!children.Contains(view))
+				{
+					children.Add(view);
+				}
+			}
+			else
+			{
+				AddNativeAccessibilityChildren(peer, children, visited);
+			}
+		}
+	}
+
+	private static bool IsNativeAccessibilityVisible(UIView view)
+	{
+		// The shared IsOffscreen implementation is Skia-only. UIKit owns native
+		// attachment and inherited visibility; collapsed children must not leak
+		// through an explicit accessibilityElements array.
+		if (view?.Window is null)
+		{
+			return false;
+		}
+		for (var current = view; current is not null; current = current.Superview)
+		{
+			if (current.Hidden || current.Alpha <= 0)
+			{
+				return false;
+			}
+		}
+		return true;
 	}
 
