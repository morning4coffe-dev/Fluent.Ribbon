@@ -0,0 +1,194 @@
+#if HAS_UNO && (__ANDROID__ || __APPLE_UIKIT__)
+using System;
+using System.Collections.Generic;
+using System.Threading.Tasks;
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Automation;
+using Microsoft.UI.Xaml.Automation.Peers;
+using Microsoft.UI.Xaml.Automation.Provider;
+using Microsoft.UI.Xaml.Controls;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using Uno.UI.RuntimeTests.Helpers;
+
+namespace Uno.UI.RuntimeTests.Tests.Windows_UI_Xaml_Automation;
+
+[TestClass]
+public partial class Given_NativeAutomationBridge
+{
+	[TestMethod]
+	[RunsOnUIThread]
+	public async Task When_BuiltIn_List_Item_Preserves_Selected_State()
+	{
+		var owner = new ListViewItem { Content = "Native selection state" };
+		await UITestHelper.Load(owner);
+		var peer = FrameworkElementAutomationPeer.CreatePeerForElement(owner);
+		Assert.IsNotNull(peer);
+
+		foreach (var selected in new[] { false, true, false })
+		{
+			owner.IsSelected = selected;
+			await UITestHelper.WaitForIdle();
+#if __ANDROID__
+#pragma warning disable CA1422
+			using var info = Android.Views.Accessibility.AccessibilityNodeInfo.Obtain();
+#pragma warning restore CA1422
+			peer.OnInitializeAccessibilityNodeInfo(info);
+			Assert.AreEqual(selected, info.Selected);
+#else
+			peer.UpdateAccessibilityElement();
+			Assert.AreEqual(selected,
+				(owner.AccessibilityTraits & UIKit.UIAccessibilityTrait.Selected) != 0);
+#endif
+		}
+	}
+
+	[TestMethod]
+	[RunsOnUIThread]
+	public void When_Default_Activation_Uses_Advertised_Patterns()
+	{
+		var owner = new Button();
+		var peer = new ConditionalPeer(owner);
+
+		Assert.IsFalse(peer.InvokeAutomationPeer());
+		Assert.AreEqual(0, peer.InvokeCount);
+		Assert.AreEqual(0, peer.ToggleCount);
+
+		peer.ActivePattern = PatternInterface.Toggle;
+		Assert.IsTrue(peer.InvokeAutomationPeer());
+		Assert.AreEqual(1, peer.ToggleCount);
+		Assert.AreEqual(0, peer.InvokeCount);
+
+		peer.ActivePattern = PatternInterface.ExpandCollapse;
+		Assert.IsTrue(peer.InvokeAutomationPeer());
+		Assert.AreEqual(ExpandCollapseState.Expanded, peer.ExpandCollapseState);
+		Assert.IsTrue(peer.InvokeAutomationPeer());
+		Assert.AreEqual(ExpandCollapseState.Collapsed, peer.ExpandCollapseState);
+	}
+
+#if __ANDROID__
+	[TestMethod]
+	[RunsOnUIThread]
+	public void When_Android_Queries_A_Conditional_Toggle_Provider()
+	{
+		var owner = new Button();
+		var peer = new ConditionalPeer(owner);
+#pragma warning disable CA1422
+		using var info = Android.Views.Accessibility.AccessibilityNodeInfo.Obtain();
+#pragma warning restore CA1422
+		peer.OnInitializeAccessibilityNodeInfo(info);
+		Assert.IsFalse(info.Checkable);
+		Assert.IsFalse(info.Checked);
+		Assert.AreEqual(0, peer.ToggleStateReads);
+
+		peer.ActivePattern = PatternInterface.Toggle;
+		peer.OnInitializeAccessibilityNodeInfo(info);
+		Assert.IsTrue(info.Checkable);
+		Assert.IsTrue(info.Checked);
+		Assert.AreEqual(1, peer.ToggleStateReads);
+
+		peer.ActivePattern = PatternInterface.ExpandCollapse;
+		peer.OnInitializeAccessibilityNodeInfo(info);
+		Assert.IsFalse(info.Checkable);
+		Assert.IsFalse(info.Checked);
+		Assert.IsTrue(info.Clickable);
+		Assert.AreEqual(1, peer.ToggleStateReads);
+	}
+#endif
+
+#if __APPLE_UIKIT__
+	[TestMethod]
+	[RunsOnUIThread]
+	public async Task When_UIKit_Named_Group_Exposes_Real_Child_Views()
+	{
+		var owner = new NativeContainer { Width = 300, Height = 100 };
+		var first = new Button { Content = "First", Width = 100, Height = 30 };
+		var hidden = new Button { Content = "Hidden", Visibility = Visibility.Collapsed };
+		owner.Children.Add(first);
+		owner.Children.Add(hidden);
+		AutomationProperties.SetName(owner, "Named group");
+		await UITestHelper.Load(owner);
+
+		var peer = (ContainerPeer)FrameworkElementAutomationPeer.CreatePeerForElement(owner);
+		Assert.IsFalse(owner.IsAccessibilityElement);
+		Assert.AreEqual("Named group", owner.AccessibilityLabel);
+		Assert.AreEqual(UIKit.UIAccessibilityContainerType.SemanticGroup, peer.GetNativeAccessibilityContainerType());
+		CollectionAssert.AreEqual(new Foundation.NSObject[] { first }, peer.GetNativeAccessibilityChildren());
+
+		var second = new Button { Content = "Second", Width = 100, Height = 30 };
+		owner.Children.Remove(first);
+		owner.Children.Add(second);
+		await UITestHelper.WaitForIdle();
+		CollectionAssert.AreEqual(new Foundation.NSObject[] { second }, peer.GetNativeAccessibilityChildren());
+
+		second.Visibility = Visibility.Collapsed;
+		await UITestHelper.WaitForIdle();
+		CollectionAssert.AreEqual(Array.Empty<Foundation.NSObject>(), peer.GetNativeAccessibilityChildren());
+		second.Visibility = Visibility.Visible;
+		await UITestHelper.WaitForIdle();
+		CollectionAssert.AreEqual(new Foundation.NSObject[] { second }, peer.GetNativeAccessibilityChildren());
+
+		AutomationProperties.SetName(owner, "Renamed group");
+		Assert.IsFalse(owner.IsAccessibilityElement);
+		Assert.AreEqual("Renamed group", owner.AccessibilityLabel);
+
+		await UITestHelper.Load(new Grid());
+		Assert.IsFalse(owner.IsAccessibilityElement);
+		Assert.IsNull(peer.GetNativeAccessibilityChildren());
+	}
+
+	public sealed partial class NativeContainer : StackPanel
+	{
+		protected override AutomationPeer OnCreateAutomationPeer() => new ContainerPeer(this);
+	}
+
+	private sealed class ContainerPeer(NativeContainer owner) : FrameworkElementAutomationPeer(owner)
+	{
+		protected override AutomationControlType GetAutomationControlTypeCore() => AutomationControlType.Group;
+
+		protected override IList<AutomationPeer> GetChildrenCore()
+		{
+			var result = new List<AutomationPeer>();
+			foreach (var child in owner.Children)
+			{
+				if (CreatePeerForElement(child) is { } peer)
+				{
+					result.Add(peer);
+				}
+			}
+			return result;
+		}
+	}
+#endif
+
+	private sealed class ConditionalPeer(FrameworkElement owner) :
+		FrameworkElementAutomationPeer(owner), IInvokeProvider, IToggleProvider, IExpandCollapseProvider
+	{
+		internal PatternInterface? ActivePattern { get; set; }
+		internal int InvokeCount { get; private set; }
+		internal int ToggleCount { get; private set; }
+		internal int ToggleStateReads { get; private set; }
+
+		protected override object GetPatternCore(PatternInterface patternInterface)
+			=> patternInterface == ActivePattern ? this : null;
+
+		public ToggleState ToggleState
+		{
+			get
+			{
+				if (ActivePattern != PatternInterface.Toggle)
+				{
+					throw new InvalidOperationException("An unadvertised Toggle provider must not be queried.");
+				}
+				ToggleStateReads++;
+				return ToggleState.On;
+			}
+		}
+
+		public ExpandCollapseState ExpandCollapseState { get; private set; } = ExpandCollapseState.Collapsed;
+		public void Expand() => ExpandCollapseState = ExpandCollapseState.Expanded;
+		public void Collapse() => ExpandCollapseState = ExpandCollapseState.Collapsed;
+		public void Invoke() => InvokeCount++;
+		public void Toggle() => ToggleCount++;
+	}
+}
+#endif
