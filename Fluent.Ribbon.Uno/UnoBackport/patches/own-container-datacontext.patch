@@ -23,6 +23,79 @@ namespace Uno.UI.Tests.ItemsControlTests
 	[TestClass]
 	public class Given_ItemsControl
 	{
+#if HAS_UNO || IS_UNIT_TESTS
+		[TestMethod]
+		[DataRow(false)]
+		[DataRow(true)]
+		public void When_Cleanup_Own_Container_Preserves_DataContext(bool bound)
+		{
+			var model = new object();
+			var bindingSource = new ContentControl { Content = model };
+			var container = new ContentControl { Content = "Authored content" };
+			if (bound)
+			{
+				container.SetBinding(FrameworkElement.DataContextProperty, new Binding
+				{
+					Source = bindingSource,
+					Path = new PropertyPath(nameof(ContentControl.Content)),
+					Mode = BindingMode.OneWay
+				});
+			}
+			else
+			{
+				container.DataContext = model;
+			}
+
+			var control = new ItemsControl();
+			control.Items.Add(container);
+			control.PrepareContainerForIndex(container, 0);
+			Assert.IsTrue(container.IsOwnContainer);
+			Assert.AreSame(model, container.DataContext);
+			var expression = container.GetBindingExpression(FrameworkElement.DataContextProperty);
+			if (bound)
+			{
+				Assert.IsNotNull(expression);
+			}
+
+			control.CleanUpContainer(container);
+
+			Assert.AreSame(model, container.DataContext);
+			Assert.AreEqual("Authored content", container.Content);
+			Assert.AreSame(expression, container.GetBindingExpression(FrameworkElement.DataContextProperty));
+			if (bound)
+			{
+				var replacement = new object();
+				bindingSource.Content = replacement;
+				Assert.AreSame(replacement, container.DataContext, "Cleanup must preserve the live binding, not just its last value.");
+			}
+		}
+
+		[TestMethod]
+		public void When_Cleanup_Generated_Container_Still_Blocks_Inherited_DataContext()
+		{
+			var inherited = new object();
+			var panel = new StackPanel { DataContext = inherited };
+			var container = new ContentControl();
+			panel.Children.Add(container);
+			Assert.AreSame(inherited, container.DataContext);
+
+			var item = new object();
+			var control = new ItemsControl();
+			control.Items.Add(item);
+			control.PrepareContainerForIndex(container, 0);
+			Assert.IsFalse(container.IsOwnContainer);
+			Assert.AreSame(item, container.DataContext);
+
+			control.CleanUpContainer(container);
+
+			Assert.IsNull(container.DataContext);
+			Assert.IsNull(container.ReadLocalValue(FrameworkElement.DataContextProperty),
+				"Generated-container cleanup must explicitly set null, not clear the local value and inherit the parent context.");
+			panel.DataContext = new object();
+			Assert.IsNull(container.DataContext);
+		}
+#endif
+
