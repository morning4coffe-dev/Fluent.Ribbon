 using Private.Infrastructure;
 using Uno.Extensions;
@@ -28,6 +30,81 @@ namespace Uno.UI.RuntimeTests.Tests.Microsoft_UI_Xaml_Controls;
 [RunsOnUIThread]
 public class Given_TabView
 {
+	[TestMethod]
+	[DataRow(false)]
+	[DataRow(true)]
+	public async Task When_Authored_Tab_Reloaded_DataContext_Is_Preserved(bool bound)
+	{
+		var model = new object();
+		var bindingSource = new ContentControl { Content = model };
+		var content = new TextBlock { Text = "Authored tab content" };
+		var authored = new TabViewItem { Header = "Authored", Content = content };
+		if (bound)
+		{
+			authored.SetBinding(FrameworkElement.DataContextProperty, new Binding
+			{
+				Source = bindingSource,
+				Path = new PropertyPath(nameof(ContentControl.Content)),
+				Mode = BindingMode.OneWay
+			});
+		}
+		else
+		{
+			authored.DataContext = model;
+		}
+		var tabs = new TabView { Width = 640, Height = 240, IsAddTabButtonVisible = false };
+		var other = new TabViewItem { Header = "Other", Content = new TextBlock { Text = "Other content" } };
+		tabs.TabItems.Add(other);
+		tabs.TabItems.Add(authored);
+		tabs.SelectedItem = authored;
+		var host = new Grid { Width = 640, Height = 300 };
+		host.Children.Add(tabs);
+		try
+		{
+			await UITestHelper.Load(host);
+			await WindowHelper.WaitForLoaded(authored);
+			Assert.AreSame(model, authored.DataContext);
+			var expression = authored.GetBindingExpression(FrameworkElement.DataContextProperty);
+			if (bound)
+			{
+				Assert.IsNotNull(expression);
+			}
+			var items = tabs.TabItems;
+
+			for (var cycle = 0; cycle < 3; cycle++)
+			{
+				host.Children.Remove(tabs);
+				await WindowHelper.WaitFor(() => !tabs.IsLoaded && !authored.IsLoaded);
+				await WindowHelper.WaitForIdle();
+				Assert.AreSame(model, authored.DataContext, $"Authored context after unload {cycle}.");
+
+				host.Children.Add(tabs);
+				await WindowHelper.WaitForLoaded(authored);
+				await WindowHelper.WaitForIdle();
+				Assert.AreSame(items, tabs.TabItems);
+				Assert.AreSame(other, tabs.TabItems[0]);
+				Assert.AreSame(authored, tabs.TabItems[1]);
+				Assert.AreSame(authored, tabs.SelectedItem);
+				Assert.AreEqual(1, tabs.SelectedIndex);
+				Assert.AreSame(content, authored.Content);
+				Assert.AreSame(model, authored.DataContext, $"Authored context after reload {cycle}.");
+				Assert.AreSame(expression, authored.GetBindingExpression(FrameworkElement.DataContextProperty));
+			}
+
+			if (bound)
+			{
+				var replacement = new object();
+				bindingSource.Content = replacement;
+				await WindowHelper.WaitFor(() => ReferenceEquals(replacement, authored.DataContext));
+				Assert.AreSame(expression, authored.GetBindingExpression(FrameworkElement.DataContextProperty));
+			}
+		}
+		finally
+		{
+			await UITestHelper.Load(new Grid());
+		}
+	}
+
