+[PlatformCondition(ConditionMode.Include, RuntimeTestPlatforms.SkiaWasm)]
+public partial class Given_WebAssemblySemanticContainers
+{
+	[TestMethod]
+	public async Task When_Logical_Selection_Items_Have_No_Visual_Peer_Then_Options_Use_Their_Real_Providers()
+	{
+		var name = "logical-" + Guid.NewGuid().ToString("N");
+		var gallery = new LogicalSelectionControl { Width = 320, Height = 100 };
+		var first = new Border { Width = 60, Height = 24, Child = new TextBlock { Text = name + "-first" } };
+		var second = new Border { Width = 60, Height = 24, Child = new TextBlock { Text = name + "-second" } };
+		gallery.ItemsHost.Children.Add(first);
+		gallery.ItemsHost.Children.Add(second);
+		gallery.Action.Content = name + "-action";
+		AutomationProperties.SetName(gallery, name);
+		try
+		{
+			await UITestHelper.Load(gallery);
+			var exporter = EnableExporter();
+			var peer = (LogicalSelectionPeer)FrameworkElementAutomationPeer.CreatePeerForElement(gallery);
+			Assert.AreEqual(0, gallery.Items.Count, "The custom selector must not use the default generator.");
+			Assert.IsNull(FrameworkElementAutomationPeer.FromElement(first), "The visual itself deliberately has no peer.");
+			Assert.AreSame(first, peer.ItemPeer(first).GetContainer());
+			var selector = NamedSelector(name);
+			await WaitForDom($"document.querySelector({Quote(selector)})?.querySelectorAll('[role=\"option\"]').length === 2");
+			AssertDom($"document.querySelector({Quote(selector)})?.querySelectorAll('button').length === 0");
+			AssertDom($"document.querySelectorAll({Quote(NamedSelector(name + "-action"))}).length === 1");
+
+			var firstSelector = NamedSelector(name + "-first");
+			ExecuteJs($"document.querySelector({Quote(firstSelector)}).dispatchEvent(new KeyboardEvent('keydown', {{ key: ' ', bubbles: true, cancelable: true }}))");
+			await TestServices.WindowHelper.WaitFor(() => ReferenceEquals(gallery.SelectedVisual, first));
+			await WaitForDom($"document.querySelector({Quote(firstSelector)})?.getAttribute('aria-selected') === 'true'");
+
+			peer.Select(second);
+			await WaitForDom($"document.querySelector({Quote(firstSelector)})?.getAttribute('aria-selected') === 'false'");
+			await WaitForDom($"document.querySelector({Quote(NamedSelector(name + "-second"))})?.getAttribute('aria-selected') === 'true'");
+			first.Visibility = Visibility.Collapsed;
+			await WaitForDom($"document.querySelectorAll({Quote(firstSelector)}).length === 0");
+			gallery.ItemsHost.Children.Remove(second);
+			await WaitForDom($"document.querySelector({Quote(selector)})?.querySelectorAll('[role=\"option\"]').length === 0");
+			await UITestHelper.Load(new Grid());
+			AssertRegistration(exporter, gallery, expected: false);
