+++ b/src/Uno.UI.Runtime.Skia.WebAssembly.Browser/Accessibility/WebAssemblyAccessibility.Containers.cs
@@ -0,0 +1,376 @@
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Automation;
+using Microsoft.UI.Xaml.Automation.Peers;
+using Microsoft.UI.Xaml.Automation.Provider;
+using Microsoft.UI.Xaml.Controls;
+using Microsoft.UI.Xaml.Controls.Primitives;
+using Uno.Extensions;
+
+namespace Uno.UI.Runtime.Skia;
+
+internal partial class WebAssemblyAccessibility
+{
+	private sealed class SemanticContainerSubscription(
+		UIElement container,
+		VirtualizedSemanticRegion region)
+	{
+		internal UIElement Container { get; } = container;
+		internal VirtualizedSemanticRegion Region { get; } = region;
+		internal Dictionary<IntPtr, (UIElement Element, int Index, AutomationPeer Peer)> Items { get; } = new();
+		internal HashSet<IntPtr> DeferredRemovals { get; } = new();
+		internal Action Unsubscribe { get; set; } = () => { };
+		internal bool Refreshing { get; set; }
+		internal bool RefreshPending { get; set; }
+		internal bool UsesLogicalPeers { get; init; }
+	}
+
+	private bool TryRegisterVirtualizedContainer(UIElement element)
+	{
+		var peer = element.GetOrCreateAutomationPeer();
+		var usesLogicalPeers = element is Selector and not (ListViewBase or ComboBox)
+			&& peer is not null && peer.GetAutomationControlType() == AutomationControlType.List
+			&& peer.GetPattern(PatternInterface.Selection) is ISelectionProvider;
+		if ((element is not (ListViewBase or ItemsRepeater) && !usesLogicalPeers) || !IsSemanticElement(element))
+		{
+			return false;
+		}
+		if (_semanticContainers.ContainsKey(element))
+		{
+			return true;
+		}
+
+		// The container DOM must exist before its items are emitted. Activation must
+		// also register containers that were loaded before accessibility was enabled.
+		if (!_semanticParentMap.ContainsKey(element.Visual.Handle))
+		{
+			return false;
+		}
+
+		var list = element as ListViewBase;
+		var role = element is TabViewListView ? "tablist" : element is GridView ? "grid" : "listbox";
+		var region = new VirtualizedSemanticRegion(
+			element.Visual.Handle,
+			role,
+			peer?.GetName(),
+			peer?.GetPattern(PatternInterface.Selection) is ISelectionProvider selection && selection.CanSelectMultiple);
+		var subscription = new SemanticContainerSubscription(element, region) { UsesLogicalPeers = usesLogicalPeers };
+		_semanticContainers.Add(element, subscription);
+		_virtualizedRegions.Add(region);
+
+		var frameworkElement = (FrameworkElement)element;
+		void Loaded(object sender, RoutedEventArgs args) => RefreshSemanticContainer(subscription);
+		frameworkElement.Loaded += Loaded;
+		if (list is not null)
+		{
+			void Changed(ListViewBase sender, ContainerContentChangingEventArgs args)
+			{
+				if (args.ItemContainer is not { } item)
+				{
+					return;
+				}
+				if (args.InRecycleQueue)
+				{
+					RemoveSemanticItem(subscription, item.Visual.Handle, args.ItemIndex);
+				}
+				else
+				{
+					RefreshSemanticItem(subscription, item, args.ItemIndex, list.Items.Count);
+				}
+			}
+			void Selected(object sender, SelectionChangedEventArgs args) => RefreshSemanticContainer(subscription);
+			list.ContainerContentChanging += Changed;
+			list.SelectionChanged += Selected;
+			subscription.Unsubscribe = () =>
+			{
+				frameworkElement.Loaded -= Loaded;
+				list.ContainerContentChanging -= Changed;
+				list.SelectionChanged -= Selected;
+			};
+		}
+		else if (element is ItemsRepeater repeater)
+		{
+			void Prepared(ItemsRepeater sender, ItemsRepeaterElementPreparedEventArgs args) =>
+				RefreshSemanticItem(subscription, args.Element, args.Index, repeater.ItemsSourceView?.Count ?? 0);
+			void Clearing(ItemsRepeater sender, ItemsRepeaterElementClearingEventArgs args) =>
+				RemoveSemanticItem(subscription, args.Element.Visual.Handle);
+			void Reindexed(ItemsRepeater sender, ItemsRepeaterElementIndexChangedEventArgs args) =>
+				RefreshSemanticItem(subscription, args.Element, args.NewIndex, repeater.ItemsSourceView?.Count ?? 0);
+			repeater.ElementPrepared += Prepared;
+			repeater.ElementClearing += Clearing;
+			repeater.ElementIndexChanged += Reindexed;
+			subscription.Unsubscribe = () =>
+			{
+				frameworkElement.Loaded -= Loaded;
+				repeater.ElementPrepared -= Prepared;
+				repeater.ElementClearing -= Clearing;
+				repeater.ElementIndexChanged -= Reindexed;
+			};
+		}
+		else if (element is Selector selector)
+		{
+			void Selected(object sender, SelectionChangedEventArgs args) => RefreshSemanticContainer(subscription);
+			selector.SelectionChanged += Selected;
+			subscription.Unsubscribe = () =>
+			{
+				frameworkElement.Loaded -= Loaded;
+				selector.SelectionChanged -= Selected;
+			};
+		}
+
+		RefreshSemanticContainer(subscription);
+		return true;
+	}
+
+	private void ScheduleSemanticContainerRefresh(SemanticContainerSubscription subscription)
+	{
+		if (subscription.Refreshing || subscription.RefreshPending
+			|| !_semanticContainers.TryGetValue(subscription.Container, out var current)
+			|| !ReferenceEquals(current, subscription))
+		{
+			return;
+		}
+		subscription.RefreshPending = true;
+		if (!subscription.Container.DispatcherQueue.TryEnqueue(() =>
+			{
+				subscription.RefreshPending = false;
+				if (_semanticContainers.TryGetValue(subscription.Container, out var live)
+					&& ReferenceEquals(live, subscription))
+				{
+					RefreshSemanticContainer(subscription);
+				}
+			}))
+		{
+			subscription.RefreshPending = false;
+			throw new InvalidOperationException("Could not enqueue realized accessibility container refresh.");
+		}
+	}
+
+	private void RefreshSemanticContainer(SemanticContainerSubscription subscription)
+	{
+		if (subscription.Refreshing
+			|| !_semanticContainers.TryGetValue(subscription.Container, out var current)
+			|| !ReferenceEquals(current, subscription))
+		{
+			return;
+		}
+		subscription.Refreshing = true;
+		try
+		{
+			var seen = new HashSet<IntPtr>();
+			// Enumerate materialized UI children, never the data source: a million-item
+			// list must not generate a million peers or force offscreen realization.
+			if (subscription.Container is ListViewBase list && list.ItemsPanelRoot is { } panel)
+			{
+				foreach (var item in panel.Children.ToArray())
+				{
+					var index = list.IndexFromContainer(item);
+					if (index >= 0 && ReferenceEquals(list.ContainerFromIndex(index), item) && IsEffectivelyVisible(item))
+					{
+						seen.Add(item.Visual.Handle);
+						RefreshSemanticItem(subscription, item, index, list.Items.Count);
+					}
+				}
+				subscription.Region.UpdateItemCount(list.Items.Count);
+			}
+			else if (subscription.Container is ItemsRepeater repeater)
+			{
+				foreach (var item in repeater.Children.ToArray())
+				{
+					var index = repeater.GetElementIndex(item);
+					if (index >= 0 && ReferenceEquals(repeater.TryGetElement(index), item) && IsEffectivelyVisible(item))
+					{
+						seen.Add(item.Visual.Handle);
+						RefreshSemanticItem(subscription, item, index, repeater.ItemsSourceView?.Count ?? 0);
+					}
+				}
+				subscription.Region.UpdateItemCount(repeater.ItemsSourceView?.Count ?? 0);
+			}
+			else if (subscription.UsesLogicalPeers)
+			{
+				// The peer tree, not a visual's default peer, owns a custom selector's
+				// selection contract. GetChildren returns realized peers; no ItemsSource walk.
+				var peers = subscription.Container.GetOrCreateAutomationPeer()?.GetChildren();
+				var realized = new List<(UIElement Element, AutomationPeer Peer)>();
+				if (peers is not null)
+				{
+					foreach (var peer in peers)
+					{
+						var item = peer switch
+						{
+							ItemAutomationPeer itemPeer => itemPeer.GetContainer(),
+							FrameworkElementAutomationPeer frameworkPeer => frameworkPeer.Owner,
+							_ => null
+						};
+						if (item is not null && IsEffectivelyVisible(item)
+							&& peer.GetPattern(PatternInterface.SelectionItem) is ISelectionItemProvider
+							&& seen.Add(item.Visual.Handle))
+						{
+							realized.Add((item, peer));
+						}
+					}
+				}
+				for (var index = 0; index < realized.Count; index++)
+				{
+					var item = realized[index];
+					RefreshSemanticItem(subscription, item.Element, index, realized.Count, item.Peer);
+				}
+				subscription.Region.UpdateItemCount(realized.Count);
+
+				// Keep actual template actions exposed, but outside the atomic listbox
+				// contract. Owned option visuals are exported once through their peers.
+				var parentHandle = _semanticParentMap[subscription.Container.Visual.Handle];
+				foreach (var child in subscription.Container.GetChildren())
+				{
+					BuildSemanticsTreeRecursive(parentHandle, child);
+				}
+			}
+			foreach (var handle in subscription.Items.Keys.Where(handle => !seen.Contains(handle)).ToArray())
+			{
+				RemoveSemanticItem(subscription, handle);
+			}
+		}
+		finally
+		{
+			subscription.Refreshing = false;
+		}
+	}
+
+	private void RefreshSemanticItem(
+		SemanticContainerSubscription subscription,
+		UIElement item,
+		int index,
+		int totalCount,
+		AutomationPeer? itemPeer = null)
+	{
+		if (!_semanticContainers.TryGetValue(subscription.Container, out var current)
+			|| !ReferenceEquals(current, subscription) || index < 0)
+		{
+			return;
+		}
+		if (!IsEffectivelyVisible(item))
+		{
+			RemoveSemanticItem(subscription, item.Visual.Handle);
+			return;
+		}
+		var handle = item.Visual.Handle;
+		var parentHandle = subscription.Container.Visual.Handle;
+		var peer = itemPeer ?? item.GetOrCreateAutomationPeer();
+		if (peer is null)
+		{
+			return;
+		}
+		if (_semanticItemOwners.TryGetValue(handle, out var previous)
+			&& !ReferenceEquals(previous, subscription))
+		{
+			RemoveSemanticItem(previous, handle);
+		}
+		if (itemPeer is not null && _semanticParentMap.TryGetValue(handle, out var oldParent)
+			&& (!subscription.Items.TryGetValue(handle, out var oldItem) || !ReferenceEquals(oldItem.Peer, peer)))
+		{
+			RemoveSemanticElement(oldParent, handle);
+			_semanticParentMap.Remove(handle);
+		}
+		if (!_semanticParentMap.ContainsKey(handle))
+		{
+			// Use the real peer factory for role, keyboard handlers and initial state.
+			// In particular a TabViewItem is a tab, not a listbox option.
+			if (!AddSemanticElement(parentHandle, item, index, peer))
+			{
+				return;
+			}
+			_semanticParentMap[handle] = parentHandle;
+		}
+		subscription.Items[handle] = (item, index, peer);
+		subscription.DeferredRemovals.Remove(handle);
+		_semanticItemOwners[handle] = subscription;
+		var attributes = AriaMapper.GetAriaAttributes(peer);
+		var role = AriaMapper.GetAriaRole(peer.GetAutomationControlType())
+			?? (subscription.Container is GridView ? "row" : "option");
+		var bounds = GetSemanticBounds(item, subscription.Container);
+		subscription.Region.OnItemRealized(handle, index, totalCount,
+			(float)bounds.X, (float)bounds.Y, (float)bounds.Width, (float)bounds.Height, role, attributes.Label ?? string.Empty);
+		NativeMethods.UpdateAriaLabel(handle, attributes.Label ?? string.Empty);
+		if (attributes.Selected is { } selected)
+		{
+			NativeMethods.UpdateSelectionState(handle, selected);
+			if (selected && !attributes.Disabled && subscription.Container is TabViewListView)
+			{
+				NativeMethods.UpdateRovingTabindex(parentHandle, handle);
+			}
+		}
+		NativeMethods.UpdateDisabledState(handle, attributes.Disabled);
+	}
+
+	private void RemoveSemanticItem(
+		SemanticContainerSubscription subscription,
+		IntPtr handle,
+		int? expectedIndex = null)
+	{
+		if (!subscription.Items.TryGetValue(handle, out var item)
+			|| (expectedIndex.HasValue && item.Index != expectedIndex.Value))
+		{
+			return;
+		}
+		if (subscription.Region.IsFocusPinned && subscription.Region.PinnedIndex == item.Index)
+		{
+			subscription.DeferredRemovals.Add(handle);
+			return;
+		}
+		subscription.Items.Remove(handle);
+		subscription.DeferredRemovals.Remove(handle);
+		_semanticItemOwners.Remove(handle);
+		if (_semanticParentMap.Remove(handle, out var parentHandle))
+		{
+			RemoveSemanticElement(parentHandle, handle);
+		}
+		subscription.Region.OnItemUnrealized(handle, item.Index);
+	}
+
+	private AutomationPeer? GetSemanticItemPeer(UIElement element)
+		=> _semanticItemOwners.TryGetValue(element.Visual.Handle, out var subscription)
+			&& subscription.Items.TryGetValue(element.Visual.Handle, out var item)
+				? item.Peer
+				: element.GetOrCreateAutomationPeer();
+
+	private bool TryFindSemanticContainer(UIElement? element, out SemanticContainerSubscription subscription)
+	{
+		for (var current = element; current is not null; current = current.GetParent() as UIElement)
+		{
+			if (_semanticContainers.TryGetValue(current, out subscription!))
+			{
+				return true;
+			}
+		}
+		subscription = null!;
+		return false;
+	}
+
+	private static bool IsEffectivelyVisible(UIElement element)
+	{
+		for (var current = element; current is not null; current = current.GetParent() as UIElement)
+		{
+			if (!current.Visual.IsVisible)
+			{
+				return false;
+			}
+		}
+		return true;
+	}
+
+	private bool IsInAccessibilityRoot(UIElement element)
+	{
+		for (var current = element; current is not null; current = current.GetParent() as UIElement)
+		{
+			if (current.Visual.Handle == _rootElementHandle)
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+}
