+
+		public LogicalSelectionControl()
+		{
+			Template = new ControlTemplate(() => new StackPanel { Children = { ItemsHost, Action } });
+		}
+
+		protected override AutomationPeer OnCreateAutomationPeer() => new LogicalSelectionPeer(this);
+	}
