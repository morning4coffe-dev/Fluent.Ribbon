+	// As in Given_MultiWindowAccessibility, the runtime host is inspected through
+	// reflection because RuntimeTests does not reference the platform host assembly.
+	private static object EnableExporter()
+	{
+		var assembly = AppDomain.CurrentDomain.GetAssemblies().Single(
+			item => item.GetName().Name == "Uno.UI.Runtime.Skia.WebAssembly.Browser");
+		var type = assembly.GetType("Uno.UI.Runtime.Skia.WebAssemblyAccessibility", throwOnError: true)!;
+		Invoke(type.GetMethod("EnableAccessibility", BindingFlags.Static | BindingFlags.Public)
+			?? throw new MissingMethodException(type.FullName, "EnableAccessibility"), null);
+		return type.GetProperty("Instance", BindingFlags.Static | BindingFlags.NonPublic)?.GetValue(null)
+			?? throw new InvalidOperationException("The WASM exporter instance was not initialized.");
+	}
+
+	private static void ExportExistingSubtree(object exporter, UIElement element)
+	{
+		var parent = VisualTreeHelper.GetParent(element) as UIElement
+			?? throw new InvalidOperationException("The regression fixture must already be in the real visual tree.");
+		var type = exporter.GetType();
+		var findParent = type.GetMethod("FindSemanticParent", BindingFlags.Instance | BindingFlags.NonPublic)
+			?? throw new MissingMethodException(type.FullName, "FindSemanticParent");
+		var parentHandle = Invoke(findParent, exporter, parent);
+		var build = type.GetMethod("BuildSemanticsTreeRecursive", BindingFlags.Instance | BindingFlags.NonPublic)
+			?? throw new MissingMethodException(type.FullName, "BuildSemanticsTreeRecursive");
+		Invoke(build, exporter, parentHandle, element, 0);
+	}
+
+	private static void AssertRegistration(object exporter, UIElement container, bool expected)
+	{
+		var registrations = exporter.GetType().GetField("_semanticContainers", BindingFlags.Instance | BindingFlags.NonPublic)?.GetValue(exporter) as IDictionary
+			?? throw new InvalidOperationException("Missing realized-container subscription registry.");
+		Assert.AreEqual(expected, registrations.Contains(container), "Container event subscriptions must follow real attachment.");
+	}
+
+	private static T? Descendant<T>(DependencyObject root) where T : class, DependencyObject
+	{
+		if (root is T match)
+		{
+			return match;
+		}
+		for (var index = 0; index < VisualTreeHelper.GetChildrenCount(root); index++)
+		{
+			if (Descendant<T>(VisualTreeHelper.GetChild(root, index)) is { } child)
+			{
+				return child;
+			}
+		}
+		return null;
+	}
+
+	private static string NamedSelector(string name) => $"#uno-semantics-root [aria-label={Quote(name)}]";
+	private static string TabSelector(TabViewItem item) => NamedSelector(item.Header.ToString()!) + "[role=\"tab\"]";
+	private static string Quote(string value) => JsonSerializer.Serialize(value);
+	private static void AssertDom(string expression) => Assert.AreEqual("true", ExecuteJs($"String(Boolean({expression}))"), expression);
+	private static Task WaitForDom(string expression) =>
+		TestServices.WindowHelper.WaitFor(() => ExecuteJs($"String(Boolean({expression}))") == "true");
+
+	private static string ExecuteJs(string expression)
+	{
+		var type = Type.GetType("Uno.Foundation.WebAssemblyRuntime, Uno.Foundation", throwOnError: true)!;
+		var method = type.GetMethod("InvokeJS", BindingFlags.Static | BindingFlags.Public, null, new[] { typeof(string) }, null)
+			?? throw new MissingMethodException(type.FullName, "InvokeJS");
+		return Invoke(method, null, expression) as string
+			?? throw new InvalidOperationException("The browser JS bridge did not return a string.");
+	}
+
+	private static object? Invoke(MethodInfo method, object? target, params object?[] args)
+	{
+		try
+		{
+			return method.Invoke(target, args);
+		}
+		catch (TargetInvocationException exception) when (exception.InnerException is not null)
+		{
+			ExceptionDispatchInfo.Capture(exception.InnerException).Throw();
+			throw;
+		}
+	}
+}
