<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-android;net10.0-windows10.0.26100;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <!-- Ensures the .xr.xml files are generated in a proper layout folder -->
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fluent</RootNamespace>
    <AssemblyName>Fluent.Ribbon.Uno</AssemblyName>

    <!-- Package Info -->
    <PackageId>Fluent.Ribbon.Uno.Core</PackageId>
    <Description>Runtime controls and XAML resources for the cross-platform Fluent.Ribbon Uno port</Description>
    <Authors>Fluent.Ribbon Contributors</Authors>
    <PackageTags>ribbon;fluent;uno;uno-platform;winui;cross-platform;controls</PackageTags>
    <PackageLicenseFile>license\License.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/morning4coffe-dev/Fluent.Ribbon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/morning4coffe-dev/Fluent.Ribbon.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->
    
    <UnoFeatures
      Condition="'$(TargetFramework)' == 'net10.0-desktop' Or '$(TargetFramework)' == 'net10.0-browserwasm'">
      SkiaRenderer;
    </UnoFeatures>
    <!-- Ensure this Uno library is not affected by repository-wide WPF/WinForms settings -->
    <UseWpf>false</UseWpf>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- Disable Roslyn analyzers during build for the Uno port project to avoid StyleCop/WpfAnalyzers errors -->
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <!-- Disable strong-name signing since Uno Platform assemblies are not signed -->
    <SignAssembly>false</SignAssembly>
    <PublicSign>false</PublicSign>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      $(MSBuildProjectDirectory)\bin\**;
      $(MSBuildProjectDirectory)\obj\**
    </DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!--
    If you encounter this error message:

      error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
      Please update to a newer .NET SDK in order to reference this assembly.

    This means that the two packages below must be aligned with the "build" version number of
    the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
    must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref" RuntimeFrameworkVersion="10.0.22621.28" />
    <FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref" TargetingPackVersion="10.0.22621.28" /> -->
  </ItemGroup>
  <!-- Exclude repository-wide shared WPF assembly attributes not applicable to Uno projects -->
  <ItemGroup>
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Shared\GlobalAssemblyInfo.cs" />
    <None Remove="$(MSBuildThisFileDirectory)..\..\Shared\GlobalAssemblyInfo.cs" />
    <!-- Remove GitVersion.MsBuild inherited from Directory.Build.props as it doesn't work with Uno SDK projects -->
    <PackageReference Remove="GitVersion.MsBuild" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\MIGRATION.md" Pack="true" PackagePath="\" />
    <None Include="..\..\License.txt" Pack="true" PackagePath="license\License.txt" />
    <None Include="..\..\Images\Logo\Logo_128x128.png" Pack="true" PackagePath="Logo.png" />
  </ItemGroup>

  <Target Name="ExcludeGeneratedContentFromPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <Content Remove="obj\**\*;bin\**\*;$(MSBuildProjectDirectory)\obj\**\*;$(MSBuildProjectDirectory)\bin\**\*" />
      <None Remove="obj\**\*;bin\**\*;$(MSBuildProjectDirectory)\obj\**\*;$(MSBuildProjectDirectory)\bin\**\*" />
    </ItemGroup>
  </Target>

  <Target Name="ConfigureUnoThemeResourcesForPackage" BeforeTargets="_WalkEachTargetPerFramework">
    <PropertyGroup>
      <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeUnoThemeResourcesInPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>
  </Target>

  <Target Name="IncludeUnoThemeResourcesInPackage">
    <PropertyGroup>
      <_UnoNuGetTargetFramework>$(TargetFramework)</_UnoNuGetTargetFramework>
      <_UnoNuGetTargetFramework
        Condition="'$(TargetPlatformIdentifier)' != ''
                   and '$(TargetPlatformIdentifier)' != 'Windows'">$(TargetFramework)$(TargetPlatformVersion)</_UnoNuGetTargetFramework>
    </PropertyGroup>
    <ItemGroup>
      <_UnoThemeResource Include="$(MSBuildProjectDirectory)\Themes\**\*.xaml" />
      <TfmSpecificPackageFile Include="@(_UnoThemeResource)">
        <PackagePath>lib\$(_UnoNuGetTargetFramework)\$(AssemblyName)\Themes\</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>