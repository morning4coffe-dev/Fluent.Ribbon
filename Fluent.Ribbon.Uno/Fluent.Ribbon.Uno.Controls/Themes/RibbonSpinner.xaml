<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonSpinner">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonSpinner">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Large" />
                                <VisualState x:Name="Medium" />
                                <VisualState x:Name="Small">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderText.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Glyph Icon -->
                            <FontIcon
                                x:Name="GlyphIcon"
                                Glyph="{TemplateBinding IconGlyph}"
                                FontSize="16"
                                Foreground="{ThemeResource RibbonIconBrush}"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}, FallbackValue=Collapsed}" />

                            <!-- Image Icon -->
                            <Image
                                Source="{TemplateBinding MediumIcon}"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding MediumIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />

                            <!-- Header -->
                            <TextBlock
                                x:Name="HeaderText"
                                Text="{TemplateBinding Header}"
                                Foreground="{ThemeResource RibbonTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Margin="0,0,6,0" />

                            <!-- Spinner input area -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="PART_TextBox"
                                    Width="{TemplateBinding InputWidth}"
                                    VerticalAlignment="Center"
                                    TextAlignment="Right"
                                    Padding="4,2"
                                    FontSize="12" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button
                                        x:Name="PART_UpButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2,0"
                                        MinWidth="16"
                                        MinHeight="12"
                                        VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE70E;" FontSize="8" Foreground="{ThemeResource RibbonIconBrush}" />
                                    </Button>
                                    <Button
                                        x:Name="PART_DownButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2,0"
                                        MinWidth="16"
                                        MinHeight="12"
                                        VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource RibbonIconBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
