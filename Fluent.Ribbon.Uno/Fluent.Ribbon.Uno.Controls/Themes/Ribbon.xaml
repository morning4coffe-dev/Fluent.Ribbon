<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:Ribbon">
        <Setter Property="Background" Value="{ThemeResource RibbonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource RibbonBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:Ribbon">
                    <Grid x:Name="PART_LayoutRoot">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="MinimizedStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Minimized">
                                    <VisualState.Setters>
                                        <Setter Target="PART_RibbonTabControl.ContentHeight" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="QATStates">
                                <VisualState x:Name="QATAbove" />
                                <VisualState x:Name="QATBelow">
                                    <VisualState.Setters>
                                        <Setter Target="PART_QuickAccessToolBar.Visibility" Value="Collapsed" />
                                        <Setter Target="BelowRibbonRow.Height" Value="Auto" />
                                        <Setter Target="PART_BelowRibbonQAT.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="QATHidden">
                                    <VisualState.Setters>
                                        <Setter Target="PART_QuickAccessToolBar.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_BelowRibbonQAT.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="CollapseStates">
                                <VisualState x:Name="Expanded" />
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="TabControlRow.Height" Value="0" />
                                        <Setter Target="BelowRibbonRow.Height" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="TabControlRow" Height="Auto" />
                            <RowDefinition x:Name="BelowRibbonRow" Height="0" />
                        </Grid.RowDefinitions>

                        <!-- Title Bar: Menu + QAT + Contextual Groups + Title -->
                        <Grid
                            Background="{TemplateBinding Background}"
                            MinHeight="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Application Menu Button (moved to TabStripHeader) -->

                            <!-- Quick Access Toolbar (above ribbon) -->
                            <fluent:QuickAccessToolBar
                                x:Name="PART_QuickAccessToolBar"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="4,0" />

                            <!-- Title + Contextual Groups overlay -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Title (centered) -->
                                <TextBlock
                                    Text="{TemplateBinding Title}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource RibbonTextBrush}"
                                    IsHitTestVisible="False" />

                                <!-- Contextual Tab Group headers -->
                                <fluent:RibbonContextualGroupsContainer
                                    x:Name="PART_ContextualGroupsPanel"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch" />
                            </Grid>

                            <!-- Toolbar items (right side of title bar) -->
                            <StackPanel
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,0" />
                        </Grid>

                        <!-- Tab Control -->
                        <Border
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <fluent:RibbonTabControl
                                x:Name="PART_RibbonTabControl"
                                IsMinimized="{TemplateBinding IsMinimized}"
                                TabStripHeader="{TemplateBinding Menu}" />
                        </Border>

                        <!-- Quick Access Toolbar (below ribbon) -->
                        <Border
                            Grid.Row="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1">
                            <fluent:QuickAccessToolBar
                                x:Name="PART_BelowRibbonQAT"
                                Visibility="Collapsed"
                                Margin="4,2" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
