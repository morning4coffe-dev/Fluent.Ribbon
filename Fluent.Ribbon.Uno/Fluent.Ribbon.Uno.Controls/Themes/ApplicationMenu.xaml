<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:ApplicationMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:ApplicationMenu">
                    <Button
                        x:Name="PART_Button"
                        Background="{ThemeResource RibbonBackstageBackgroundBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,4"
                        MinWidth="56"
                        Height="26"
                        VerticalAlignment="Center"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- Optional icon glyph -->
                            <FontIcon
                                Glyph="{TemplateBinding IconGlyph}"
                                FontSize="12"
                                Foreground="White"
                                Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}}" />
                            <ContentPresenter
                                Content="{TemplateBinding Header}"
                                VerticalAlignment="Center">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding}"
                                            FontSize="12"
                                            FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </StackPanel>
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
