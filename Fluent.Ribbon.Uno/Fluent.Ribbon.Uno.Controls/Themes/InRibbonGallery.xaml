<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <fluent:IconConverter x:Key="InRibbonGalleryIconConverter" />

    <Style TargetType="fluent:InRibbonGallery">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource RibbonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:InRibbonGallery">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DisplayStates">
                                <VisualState x:Name="Inline" />
                                <VisualState x:Name="CollapsedToButton">
                                    <VisualState.Setters>
                                        <Setter Target="InlineContent.Visibility" Value="Collapsed" />
                                        <Setter Target="CollapsedContent.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Inline Gallery Display -->
                        <Border
                            x:Name="InlineContent"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Height="{TemplateBinding GalleryPanelContainerHeight}"
                            MinWidth="80">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Gallery items area -->
                                <ScrollViewer
                                    x:Name="PART_ScrollViewer"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollMode="Enabled">
                                    <fluent:UniformItemsPanel
                                        x:Name="PART_GalleryPanel" />
                                </ScrollViewer>

                                <!-- Side buttons: Up, Down, Expand -->
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    Width="16"
                                    Background="{ThemeResource RibbonBackgroundBrush}">
                                    <Button
                                        x:Name="PART_UpButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Height="28"
                                        Width="16"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.AutomationId="InRibbonGalleryUpButton"
                                        ToolTipService.ToolTip="Scroll up">
                                        <FontIcon Glyph="&#xE70E;" FontSize="8" Foreground="{ThemeResource RibbonIconBrush}" />
                                    </Button>

                                    <Button
                                        x:Name="PART_DownButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Height="28"
                                        Width="16"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.AutomationId="InRibbonGalleryDownButton"
                                        ToolTipService.ToolTip="Scroll down">
                                        <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource RibbonIconBrush}" />
                                    </Button>

                                    <Rectangle
                                        Height="1"
                                        Fill="{ThemeResource RibbonBorderBrush}"
                                        HorizontalAlignment="Stretch" />

                                    <Button
                                        x:Name="PART_ExpandButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Height="28"
                                        Width="16"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.AutomationId="InRibbonGalleryExpandButton"
                                        Content="{Binding ExpandButtonContent, RelativeSource={RelativeSource TemplatedParent}}"
                                        ContentTemplate="{Binding ExpandButtonContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTipService.ToolTip="More options" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Collapsed to button display -->
                        <Button
                            x:Name="CollapsedContent"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,4"
                            MinWidth="56"
                            AutomationProperties.AutomationId="InRibbonGalleryCollapsedButton"
                            VerticalAlignment="Stretch">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <!-- Icon glyph or image -->
                                <FontIcon
                                    Glyph="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}"
                                    FontSize="32"
                                    Foreground="{ThemeResource RibbonIconBrush}"
                                    Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}}" />

                                <Image
                                    Source="{Binding LargeIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource InRibbonGalleryIconConverter}}"
                                    Width="32"
                                    Height="32"
                                    Stretch="Uniform"
                                    Visibility="{Binding LargeIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />

                                <ContentPresenter
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,0" />

                                <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource RibbonIconBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
