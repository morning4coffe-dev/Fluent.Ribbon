<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonStatusBar">
        <Setter Property="Background" Value="{ThemeResource RibbonStatusBarBrush}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonStatusBar">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{ThemeResource RibbonBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left-aligned items -->
                            <StackPanel
                                x:Name="PART_LeftPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" />

                            <!-- Right-aligned items -->
                            <StackPanel
                                x:Name="PART_RightPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="fluent:RibbonStatusBarItem">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonStatusBarItem">
                    <Border Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
