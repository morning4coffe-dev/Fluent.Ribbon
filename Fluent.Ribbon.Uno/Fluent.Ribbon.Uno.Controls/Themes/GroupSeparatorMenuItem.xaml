<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:GroupSeparatorMenuItem">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:GroupSeparatorMenuItem">
                    <Grid Margin="0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Separator Line -->
                        <Rectangle
                            Height="1"
                            Fill="{ThemeResource RibbonBorderBrush}"
                            HorizontalAlignment="Stretch"
                            Margin="8,0" />

                        <!-- Group Header -->
                        <TextBlock
                            Grid.Row="1"
                            Text="{TemplateBinding Header}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource RibbonSecondaryTextBrush}"
                            Margin="12,4,12,2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
