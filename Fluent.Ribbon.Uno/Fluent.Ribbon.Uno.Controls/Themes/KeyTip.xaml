<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <!-- Office-style keyboard-accelerator chip shown while KeyTip navigation is active -->
    <Style TargetType="fluent:KeyTipVisual">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:KeyTipVisual">
                    <Border
                        Background="{ThemeResource RibbonBackgroundBrush}"
                        BorderBrush="{ThemeResource RibbonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="4,1"
                        MinWidth="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{TemplateBinding Text}"
                            FontSize="11"
                            LineHeight="12"
                            Foreground="{ThemeResource RibbonTextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
