<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:QuickAccessToolBar">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:QuickAccessToolBar">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Main toolbar items -->
                        <StackPanel
                            x:Name="PART_ToolBarPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center" />

                        <!-- Overflow button (chevron) -->
                        <Button
                            x:Name="PART_OverflowButton"
                            AutomationProperties.AutomationId="QuickAccessOverflowButton"
                            Visibility="Collapsed"
                            Background="Transparent"
                            Foreground="{ThemeResource RibbonIconBrush}"
                            BorderThickness="0"
                            Padding="4,2"
                            MinWidth="{ThemeResource RibbonCompactTargetSize}"
                            MinHeight="{ThemeResource RibbonCompactTargetSize}"
                            VerticalAlignment="Center"
                            CornerRadius="4">
                            <FontIcon Glyph="&#xE70D;" FontSize="9" />
                        </Button>

                        <!-- Menu dropdown button -->
                        <Button
                            x:Name="PART_MenuButton"
                            AutomationProperties.AutomationId="QuickAccessCustomizationButton"
                            Visibility="{Binding IsMenuDropDownVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="Transparent"
                            Foreground="{ThemeResource RibbonIconBrush}"
                            BorderThickness="0"
                            Padding="4,2"
                            MinWidth="{ThemeResource RibbonCompactTargetSize}"
                            MinHeight="{ThemeResource RibbonCompactTargetSize}"
                            VerticalAlignment="Center"
                            CornerRadius="4">
                            <FontIcon Glyph="&#xE712;" FontSize="9" />
                        </Button>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
