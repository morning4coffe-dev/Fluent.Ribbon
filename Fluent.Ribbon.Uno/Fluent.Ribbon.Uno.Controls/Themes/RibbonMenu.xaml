<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonMenu">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonMenu">
                    <Border
                        Background="{ThemeResource RibbonContentBrush}"
                        BorderBrush="{ThemeResource RibbonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                        <StackPanel
                            x:Name="PART_ItemsPanel"
                            Orientation="Vertical" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
