<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:BackstageTabControl">
        <Setter Property="ItemsPanelBackground" Value="{ThemeResource RibbonBackstageBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:BackstageTabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left menu panel -->
                        <Grid
                            Background="{TemplateBinding ItemsPanelBackground}"
                            MinWidth="{TemplateBinding ItemsPanelMinWidth}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Back button -->
                            <Button
                                x:Name="PART_BackButton"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="44"
                                Padding="16,0"
                                Visibility="{Binding IsBackButtonVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Visible}">
                                <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="White" />
                            </Button>

                            <!-- Tab items -->
                            <StackPanel
                                x:Name="PART_ItemsPanel"
                                Grid.Row="1"
                                Margin="0,8,0,0" />
                        </Grid>

                        <!-- Content area -->
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource RibbonContentBrush}"
                            Padding="24">
                            <ContentPresenter
                                x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding SelectedContent}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
