<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonSeparator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="4,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonSeparator">
                    <Rectangle
                        Fill="{ThemeResource RibbonBorderBrush}"
                        Width="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OrientationToWidthConverter}}"
                        Height="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OrientationToHeightConverter}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
