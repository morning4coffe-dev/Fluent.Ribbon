<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:ColorGallery">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:ColorGallery">
                    <StackPanel Spacing="2">
                        <!-- Automatic color -->
                        <Button
                            x:Name="PART_AutomaticButton"
                            AutomationProperties.AutomationId="ColorGalleryAutomaticButton"
                            MinHeight="{ThemeResource RibbonCompactTargetSize}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,4"
                            Visibility="{Binding IsAutomaticColorButtonVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Visible}" />

                        <!-- No color -->
                        <Button
                            x:Name="PART_NoColorButton"
                            AutomationProperties.AutomationId="ColorGalleryNoColorButton"
                            MinHeight="{ThemeResource RibbonCompactTargetSize}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,4"
                            Visibility="{Binding IsNoColorButtonVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Visible}" />

                        <!-- Theme colors -->
                        <StackPanel x:Name="PART_ThemeColorsSection" Visibility="Collapsed">
                            <TextBlock
                                x:Name="PART_ThemeColorsHeader"
                                AutomationProperties.HeadingLevel="Level3"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,4,0,2"
                                Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <StackPanel x:Name="PART_ThemeColorsPanel" />
                            <StackPanel x:Name="PART_ThemeGradientsPanel" />
                        </StackPanel>

                        <!-- Standard colors -->
                        <TextBlock
                            x:Name="PART_StandardColorsHeader"
                            AutomationProperties.HeadingLevel="Level3"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Margin="0,4,0,2"
                            Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                        <StackPanel x:Name="PART_StandardColorsPanel" />
                        <StackPanel x:Name="PART_StandardGradientsPanel" />

                        <!-- Recent colors -->
                        <StackPanel x:Name="PART_RecentColorsSection" Visibility="Collapsed">
                            <TextBlock
                                x:Name="PART_RecentColorsHeader"
                                AutomationProperties.HeadingLevel="Level3"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,4,0,2"
                                Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <StackPanel x:Name="PART_RecentColorsPanel" />
                        </StackPanel>

                        <!-- More colors -->
                        <Button
                            x:Name="PART_MoreColorsButton"
                            AutomationProperties.AutomationId="ColorGalleryMoreColorsButton"
                            MinHeight="{ThemeResource RibbonCompactTargetSize}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,4"
                            Margin="0,4,0,0"
                            Visibility="{Binding IsMoreColorsButtonVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Visible}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
