<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:StartScreen">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:StartScreen">
                    <Grid x:Name="RootGrid" IsHitTestVisible="{TemplateBinding IsOpen}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="OpenStates">
                                <VisualState x:Name="Closed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Open">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Rendered inline (not in a Popup): opening a Popup during the first
                             measure pass, before the control has a XamlRoot, fails native measure
                             on the WinUI3 head (E_FAIL). An inline overlay behaves identically on
                             the Skia and WinUI3 heads. -->
                        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Pane -->
                            <Border Background="{ThemeResource RibbonBackstageBackgroundBrush}" Padding="20"
                                    Width="{TemplateBinding LeftPaneWidth}">
                                <ContentPresenter x:Name="PART_LeftPane" Content="{TemplateBinding LeftPaneContent}" />
                            </Border>

                            <!-- Right Pane -->
                            <Border Grid.Column="1" Padding="40">
                                <ContentPresenter x:Name="PART_RightPane" Content="{TemplateBinding Content}" />
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
