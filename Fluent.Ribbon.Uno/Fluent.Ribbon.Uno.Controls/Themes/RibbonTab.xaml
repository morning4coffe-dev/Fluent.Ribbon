<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonTab">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Tab Header (handled by TabViewItem) -->

                        <!-- Content -->
                        <Border
                            Grid.Row="1"
                            Background="{ThemeResource RibbonSelectedTabBrush}"
                            BorderBrush="{ThemeResource RibbonBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="4,0">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Auto">
                                <StackPanel
                                    x:Name="PART_GroupsPanel"
                                    Orientation="Horizontal"
                                    Height="94" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
