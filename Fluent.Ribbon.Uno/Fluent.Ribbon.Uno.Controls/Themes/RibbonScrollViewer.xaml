<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Scroll-left button (shown by code when scrolled) -->
                        <Button
                            x:Name="PART_LeftButton"
                            Grid.Column="0"
                            Width="16"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed"
                            Background="{ThemeResource RibbonBackgroundBrush}"
                            BorderThickness="0">
                            <TextBlock Text="&#x2039;" FontSize="14" Foreground="{ThemeResource RibbonIconBrush}" />
                        </Button>

                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            HorizontalScrollMode="Enabled"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled" />

                        <!-- Scroll-right button (shown by code when scrollable) -->
                        <Button
                            x:Name="PART_RightButton"
                            Grid.Column="2"
                            Width="16"
                            Padding="0"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed"
                            Background="{ThemeResource RibbonBackgroundBrush}"
                            BorderThickness="0">
                            <TextBlock Text="&#x203A;" FontSize="14" Foreground="{ThemeResource RibbonIconBrush}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
