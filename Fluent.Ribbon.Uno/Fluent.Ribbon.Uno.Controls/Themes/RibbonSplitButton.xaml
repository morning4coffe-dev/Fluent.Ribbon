<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonSplitButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{ThemeResource RibbonButtonPadding}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="{ThemeResource RibbonControlMinHeight}" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonSplitButton">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="GlyphIcon.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                        <Setter Target="LabelText.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                        <Setter Target="DropDownArrow.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonSubtleBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="GlyphIcon.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                        <Setter Target="LabelText.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                        <Setter Target="DropDownArrow.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="Transparent" />
                                        <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource RibbonBorderBrush}" />
                                        <Setter Target="GlyphIcon.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                        <Setter Target="LabelText.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                        <Setter Target="DropDownArrow.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                        <Setter Target="PART_Icon.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="GlyphIcon.Foreground" Value="{ThemeResource RibbonCheckedForegroundBrush}" />
                                        <Setter Target="LabelText.Foreground" Value="{ThemeResource RibbonCheckedForegroundBrush}" />
                                        <Setter Target="DropDownArrow.Foreground" Value="{ThemeResource RibbonCheckedForegroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonCheckedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonAccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Large">
                                    <VisualState.Setters>
                                        <Setter Target="OuterPanel.Orientation" Value="Vertical" />
                                        <Setter Target="ContentPanel.Orientation" Value="Vertical" />
                                        <Setter Target="GlyphIcon.FontSize" Value="28" />
                                        <Setter Target="GlyphIcon.Margin" Value="0" />
                                        <Setter Target="PART_Icon.Width" Value="32" />
                                        <Setter Target="PART_Icon.Height" Value="32" />
                                        <Setter Target="PART_Icon.Margin" Value="0" />
                                        <Setter Target="LabelText.Visibility" Value="Visible" />
                                        <Setter Target="LabelText.Margin" Value="0,2,0,0" />
                                        <Setter Target="LabelText.MaxWidth" Value="60" />
                                        <Setter Target="DropDownArrow.Margin" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Medium">
                                    <VisualState.Setters>
                                        <Setter Target="OuterPanel.Orientation" Value="Horizontal" />
                                        <Setter Target="ContentPanel.Orientation" Value="Horizontal" />
                                        <Setter Target="GlyphIcon.FontSize" Value="16" />
                                        <Setter Target="GlyphIcon.Margin" Value="0,0,4,0" />
                                        <Setter Target="PART_Icon.Width" Value="16" />
                                        <Setter Target="PART_Icon.Height" Value="16" />
                                        <Setter Target="PART_Icon.Margin" Value="0,0,4,0" />
                                        <Setter Target="LabelText.Visibility" Value="Visible" />
                                        <Setter Target="LabelText.Margin" Value="0" />
                                        <Setter Target="LabelText.MaxWidth" Value="160" />
                                        <Setter Target="DropDownArrow.Margin" Value="2,0,0,0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Small">
                                    <VisualState.Setters>
                                        <Setter Target="OuterPanel.Orientation" Value="Horizontal" />
                                        <Setter Target="ContentPanel.Orientation" Value="Horizontal" />
                                        <Setter Target="GlyphIcon.FontSize" Value="16" />
                                        <Setter Target="GlyphIcon.Margin" Value="0" />
                                        <Setter Target="PART_Icon.Width" Value="16" />
                                        <Setter Target="PART_Icon.Height" Value="16" />
                                        <Setter Target="LabelText.Visibility" Value="Collapsed" />
                                        <Setter Target="DropDownArrow.Margin" Value="2,0,0,0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel x:Name="OuterPanel" Orientation="Vertical" Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- Primary button area -->
                            <Button
                                x:Name="PART_Button"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                MinWidth="{ThemeResource RibbonCompactTargetSize}"
                                MinHeight="{ThemeResource RibbonCompactTargetSize}"
                                IsTabStop="False"
                                AllowFocusOnInteraction="False"
                                AutomationProperties.AccessibilityView="Raw">
                                <StackPanel x:Name="ContentPanel" Orientation="Vertical"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon
                                        x:Name="GlyphIcon"
                                        Glyph="{TemplateBinding IconGlyph}"
                                        FontSize="28"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource RibbonIconBrush}"
                                        Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}, FallbackValue=Collapsed}" />
                                    <Image
                                        x:Name="PART_Icon"
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Source="{TemplateBinding CurrentIcon}"
                                        Stretch="Uniform"
                                        Visibility="{Binding CurrentIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />
                                    <TextBlock
                                        x:Name="LabelText"
                                        Text="{TemplateBinding Header}"
                                        Foreground="{ThemeResource RibbonTextBrush}"
                                        TextAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"
                                        MaxWidth="60"
                                        Margin="0,2,0,0"
                                        FontSize="11" />
                                </StackPanel>
                            </Button>

                            <!-- Dropdown arrow button: below the label for Large, inline to the right for Medium/Small -->
                            <Button
                                x:Name="PART_DropDownButton"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="2,0"
                                MinWidth="{ThemeResource RibbonCompactTargetSize}"
                                MinHeight="{ThemeResource RibbonCompactTargetSize}"
                                IsTabStop="False"
                                AllowFocusOnInteraction="False"
                                AutomationProperties.AccessibilityView="Raw">
                                <FontIcon x:Name="DropDownArrow" Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource RibbonIconBrush}"
                                         Visibility="{Binding HasTriangle, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Visible}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
