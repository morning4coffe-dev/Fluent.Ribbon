<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonCheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{ThemeResource RibbonButtonPadding}" />
        <Setter Property="MinHeight" Value="{ThemeResource RibbonControlMinHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource RibbonTextBrush}" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonCheckBox">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}"
                        Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                        <Setter Target="HeaderText.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                        <Setter Target="HeaderText.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                        <Setter Target="HeaderText.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                        <Setter Target="PART_Icon.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Large" />
                                <VisualState x:Name="Medium" />
                                <!--
                                    Check boxes have no icon to fall back on, so the label is
                                    always kept (matching Office behaviour). Collapsing it would
                                    leave a meaningless bare box when the group is reduced.
                                -->
                                <VisualState x:Name="Small" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel x:Name="ContentPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image
                                x:Name="PART_Icon"
                                Source="{TemplateBinding MediumIcon}"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                Margin="0,0,4,0"
                                Visibility="{Binding MediumIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />
                            <CheckBox
                                x:Name="Indicator"
                                IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Foreground="{TemplateBinding Foreground}"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                IsTabStop="False"
                                IsHitTestVisible="False"
                                AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock
                                x:Name="HeaderText"
                                Text="{TemplateBinding Header}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                FontSize="12" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
