<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:MenuItem">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Margin="2,1"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RibbonPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ContentGrid"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="ContentGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon (FontIcon glyph) -->
                            <FontIcon
                                Glyph="{TemplateBinding IconGlyph}"
                                FontSize="16"
                                Foreground="{ThemeResource RibbonIconBrush}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}, FallbackValue=Collapsed}" />

                            <!-- Icon -->
                            <fluent:IconPresenter
                                x:Name="PART_Icon"
                                Width="16"
                                Height="16"
                                IconSize="Small"
                                SmallIcon="{TemplateBinding Icon}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />

                            <!-- Header and Description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter
                                    Content="{TemplateBinding Header}"
                                    FontSize="12" />
                                <TextBlock
                                    Text="{TemplateBinding Description}"
                                    FontSize="11"
                                    Foreground="{ThemeResource RibbonSecondaryTextBrush}"
                                    Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}, FallbackValue=Collapsed}"
                                    TextWrapping="Wrap"
                                    Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Input Gesture Text -->
                            <TextBlock
                                Grid.Column="2"
                                Text="{TemplateBinding InputGestureText}"
                                FontSize="11"
                                Foreground="{ThemeResource RibbonSecondaryTextBrush}"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0" />

                            <!-- Sub-menu indicator -->
                            <FontIcon
                                Grid.Column="3"
                                Glyph="&#xE76C;"
                                FontSize="10"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSubItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
