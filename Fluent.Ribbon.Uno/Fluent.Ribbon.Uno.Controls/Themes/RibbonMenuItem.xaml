<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="not_win">

    <Style x:Key="RibbonMenuActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource RibbonTextBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="{ThemeResource RibbonCompactTargetSize}" />
        <Setter Property="MinWidth" Value="{ThemeResource RibbonCompactTargetSize}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="ActionBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ActionBorder.Background" Value="{ThemeResource RibbonHoverBrush}" />
                                        <Setter Target="ActionContent.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ActionBorder.Background" Value="{ThemeResource RibbonPressedBrush}" />
                                        <Setter Target="ActionContent.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ActionContent.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ActionContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="fluent:MenuItem">
        <win:Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </win:Setter>
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource RibbonTextBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:MenuItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_PrimaryButton.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                        <Setter Target="PART_SubmenuButton.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PrimaryActionStates">
                                <VisualState x:Name="PrimaryEnabled" />
                                <VisualState x:Name="PrimaryPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_PrimaryButton.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PrimaryPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_PrimaryButton.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PrimaryDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_PrimaryButton.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SubmenuActionStates">
                                <VisualState x:Name="SubmenuEnabled" />
                                <VisualState x:Name="SubmenuPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SubmenuButton.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SubmenuPressed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SubmenuButton.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SubmenuDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SubmenuButton.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SplitStates">
                                <VisualState x:Name="NotSplit" />
                                <VisualState x:Name="Split">
                                    <VisualState.Setters>
                                        <Setter Target="SplitSeparator.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="NotCheckable" />
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckIndicator.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckIndicator.Visibility" Value="Visible" />
                                        <Setter Target="CheckMark.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate">
                                    <VisualState.Setters>
                                        <Setter Target="CheckIndicator.Visibility" Value="Visible" />
                                        <Setter Target="IndeterminateMark.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="RadioUnchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckIndicator.Visibility" Value="Visible" />
                                        <Setter Target="CheckBoxOutline.Visibility" Value="Collapsed" />
                                        <Setter Target="RadioOutline.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="RadioChecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckIndicator.Visibility" Value="Visible" />
                                        <Setter Target="CheckBoxOutline.Visibility" Value="Collapsed" />
                                        <Setter Target="RadioOutline.Visibility" Value="Visible" />
                                        <Setter Target="RadioMark.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Margin="2,1"
                            Control.IsTemplateFocusTarget="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="PART_PrimaryButton"
                                    Style="{StaticResource RibbonMenuActionButtonStyle}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Padding="{TemplateBinding Padding}"
                                    AutomationProperties.AccessibilityView="Raw">
                                    <Grid x:Name="ContentGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            x:Name="CheckIndicator"
                                            Width="16" Height="16" Margin="0,0,8,0"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            AutomationProperties.AccessibilityView="Raw">
                                            <Border x:Name="CheckBoxOutline" BorderThickness="1" CornerRadius="2"
                                                    BorderBrush="{Binding Foreground, ElementName=PART_PrimaryButton}" />
                                            <FontIcon x:Name="CheckMark" Glyph="&#xE73E;" FontSize="12"
                                                      Foreground="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                                      Visibility="Collapsed" />
                                            <Rectangle x:Name="IndeterminateMark" Width="10" Height="2"
                                                       Fill="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                                       Visibility="Collapsed" />
                                            <Ellipse x:Name="RadioOutline" StrokeThickness="1"
                                                     Stroke="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                                     Visibility="Collapsed" />
                                            <Ellipse x:Name="RadioMark" Width="6" Height="6"
                                                     Fill="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                                     Visibility="Collapsed" />
                                        </Grid>
                                        <FontIcon
                                            x:Name="IconGlyph" Grid.Column="1"
                                            Glyph="{TemplateBinding IconGlyph}" FontSize="16"
                                            Foreground="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}, FallbackValue=Collapsed}" />
                                        <fluent:IconPresenter
                                            x:Name="PART_Icon" Grid.Column="1" Width="16" Height="16"
                                            IconSize="Small" SmallIcon="{TemplateBinding Icon}"
                                            Foreground="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <ContentPresenter
                                                x:Name="HeaderPresenter"
                                                Content="{TemplateBinding Header}"
                                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                                Foreground="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                                FontSize="12" />
                                            <TextBlock
                                                x:Name="AccessKeyText" FontSize="12" Visibility="Collapsed"
                                                Foreground="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                                AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock
                                                x:Name="DescriptionText" Text="{TemplateBinding Description}"
                                                FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                Foreground="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                                Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}, FallbackValue=Collapsed}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="InputGestureText" Grid.Column="3"
                                            Text="{TemplateBinding InputGestureText}" FontSize="11"
                                            Foreground="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                            VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <FontIcon
                                            x:Name="SubMenuIndicator" Grid.Column="4"
                                            Glyph="&#xE76C;" FontSize="10" Margin="8,0,0,0"
                                            MirroredWhenRightToLeft="True"
                                            Foreground="{Binding Foreground, ElementName=PART_PrimaryButton}"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                                <Button
                                    x:Name="PART_SubmenuButton" Grid.Column="1"
                                    Style="{StaticResource RibbonMenuActionButtonStyle}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Padding="6,0" Visibility="Collapsed"
                                    AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon Glyph="&#xE76C;" FontSize="10"
                                              MirroredWhenRightToLeft="True"
                                              Foreground="{Binding Foreground, ElementName=PART_SubmenuButton}"
                                              HorizontalAlignment="Center" />
                                </Button>
                                <Rectangle
                                    x:Name="SplitSeparator" Grid.Column="1" Width="1" Margin="0,4,0,4"
                                    HorizontalAlignment="Left" IsHitTestVisible="False" Visibility="Collapsed"
                                    Fill="{ThemeResource RibbonBorderBrush}" />
                            </Grid>
                        </Border>
                        <win:Grid x:Name="PART_ItemsOwner" Width="0" Height="0"
                              Visibility="Collapsed" IsHitTestVisible="False">
                            <ItemsPresenter x:Name="ItemsPresenter" />
                        </win:Grid>
                        <Popup x:Name="PART_Popup" IsLightDismissEnabled="True">
                            <fluent:ResizeableContentControl
                                x:Name="PART_PopupContentControl"
                                ResizeMode="{TemplateBinding ResizeMode}"
                                Background="{ThemeResource RibbonCardBackgroundBrush}"
                                Foreground="{ThemeResource RibbonTextBrush}"
                                BorderBrush="{ThemeResource RibbonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource RibbonPopupCornerRadius}"
                                Padding="2">
                                <ScrollViewer
                                    x:Name="PART_ScrollViewer"
                                    HorizontalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto"
                                    IsTabStop="False">
                                    <not_win:ItemsControl x:Name="PART_SubmenuItemsHost" />
                                </ScrollViewer>
                            </fluent:ResizeableContentControl>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
