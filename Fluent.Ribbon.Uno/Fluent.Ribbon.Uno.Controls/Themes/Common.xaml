<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent"
    xmlns:converters="using:Fluent.Converters">

    <!-- Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:OrientationToWidthConverter x:Key="OrientationToWidthConverter" />
    <converters:OrientationToHeightConverter x:Key="OrientationToHeightConverter" />
    <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
    <converters:NaNFallbackConverter x:Key="NaNFallbackConverter" />

    <!-- Theme-aware color resources -->
    <ResourceDictionary.ThemeDictionaries>
        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="RibbonBorderBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="RibbonAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="RibbonHoverBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="RibbonPressedBrush" Color="#CCEEFF" />
            <SolidColorBrush x:Key="RibbonSelectedTabBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonGroupHeaderBrush" Color="#737373" />
            <SolidColorBrush x:Key="RibbonTextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="RibbonSecondaryTextBrush" Color="#616161" />
            <SolidColorBrush x:Key="RibbonIconBrush" Color="#323232" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundHoverBrush" Color="#2B88D8" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundPressedBrush" Color="#005A9E" />
            <SolidColorBrush x:Key="RibbonBackstageForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonStatusBarBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="RibbonStatusBarTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonContentBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="RibbonBorderBrush" Color="#404040" />
            <SolidColorBrush x:Key="RibbonAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="RibbonHoverBrush" Color="#3D3D3D" />
            <SolidColorBrush x:Key="RibbonPressedBrush" Color="#1A3A52" />
            <SolidColorBrush x:Key="RibbonSelectedTabBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="RibbonGroupHeaderBrush" Color="#9E9E9E" />
            <SolidColorBrush x:Key="RibbonTextBrush" Color="#E4E4E4" />
            <SolidColorBrush x:Key="RibbonSecondaryTextBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="RibbonIconBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundBrush" Color="#0063B1" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundHoverBrush" Color="#1A73B2" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundPressedBrush" Color="#004D8A" />
            <SolidColorBrush x:Key="RibbonBackstageForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonStatusBarBrush" Color="#0063B1" />
            <SolidColorBrush x:Key="RibbonStatusBarTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonContentBrush" Color="#1E1E1E" />
        </ResourceDictionary>

        <!-- HighContrast Theme -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RibbonBorderBrush" Color="{ThemeResource SystemColorWindowFrameColor}" />
            <SolidColorBrush x:Key="RibbonAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonSelectedTabBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RibbonGroupHeaderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RibbonTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RibbonSecondaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="RibbonIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonBackstageForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RibbonStatusBarBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonStatusBarTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RibbonContentBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Size Constants -->
    <x:Double x:Key="RibbonLargeIconSize">32</x:Double>
    <x:Double x:Key="RibbonMediumIconSize">16</x:Double>
    <x:Double x:Key="RibbonSmallIconSize">16</x:Double>
    <x:Double x:Key="RibbonContentHeight">94</x:Double>
    <x:Double x:Key="RibbonTabHeight">24</x:Double>
    <Thickness x:Key="RibbonGroupMargin">2,0,2,0</Thickness>
    <Thickness x:Key="RibbonButtonPadding">4,2</Thickness>

</ResourceDictionary>
