<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent"
    xmlns:converters="using:Fluent.Converters">

    <!-- Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:OrientationToWidthConverter x:Key="OrientationToWidthConverter" />
    <converters:OrientationToHeightConverter x:Key="OrientationToHeightConverter" />
    <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    <converters:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
    <converters:NaNFallbackConverter x:Key="NaNFallbackConverter" />

    <!-- Size Constants -->
    <x:Double x:Key="RibbonLargeIconSize">32</x:Double>
    <x:Double x:Key="RibbonMediumIconSize">16</x:Double>
    <x:Double x:Key="RibbonSmallIconSize">16</x:Double>
    <x:Double x:Key="RibbonContentHeight">94</x:Double>
    <x:Double x:Key="RibbonTabHeight">24</x:Double>
    <x:Double x:Key="RibbonControlMinHeight">24</x:Double>
    <Thickness x:Key="RibbonGroupMargin">2,0,2,0</Thickness>
    <Thickness x:Key="RibbonButtonPadding">4,2</Thickness>

    <!-- Shape tokens (Fluent-aligned) -->
    <CornerRadius x:Key="RibbonControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="RibbonCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RibbonPopupCornerRadius">8</CornerRadius>

    <!-- Theme-aware color resources -->
    <ResourceDictionary.ThemeDictionaries>
        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#F6F6F6" />
            <SolidColorBrush x:Key="RibbonBorderBrush" Color="#E1E1E1" />
            <SolidColorBrush x:Key="RibbonSubtleBorderBrush" Color="#EDEDED" />
            <SolidColorBrush x:Key="RibbonAccentBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="RibbonAccentHoverBrush" Color="#1A6FC0" />
            <SolidColorBrush x:Key="RibbonAccentSubtleBrush" Color="#E8F1FB" />
            <SolidColorBrush x:Key="RibbonHoverBrush" Color="#ECECEC" />
            <SolidColorBrush x:Key="RibbonPressedBrush" Color="#E1EDF9" />
            <SolidColorBrush x:Key="RibbonSelectedTabBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonCardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonLayerBackgroundBrush" Color="#ECECEC" />
            <SolidColorBrush x:Key="RibbonGroupHeaderBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="RibbonTextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="RibbonSecondaryTextBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="RibbonIconBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundHoverBrush" Color="#1A6FC0" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundPressedBrush" Color="#004C93" />
            <SolidColorBrush x:Key="RibbonBackstageForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonStatusBarBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="RibbonStatusBarTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonContentBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="RibbonBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="RibbonSubtleBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="RibbonAccentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="RibbonAccentHoverBrush" Color="#7AD6FF" />
            <SolidColorBrush x:Key="RibbonAccentSubtleBrush" Color="#183042" />
            <SolidColorBrush x:Key="RibbonHoverBrush" Color="#383838" />
            <SolidColorBrush x:Key="RibbonPressedBrush" Color="#1E3A52" />
            <SolidColorBrush x:Key="RibbonSelectedTabBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="RibbonCardBackgroundBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="RibbonLayerBackgroundBrush" Color="#1D1D1D" />
            <SolidColorBrush x:Key="RibbonGroupHeaderBrush" Color="#A6A6A6" />
            <SolidColorBrush x:Key="RibbonTextBrush" Color="#E8E8E8" />
            <SolidColorBrush x:Key="RibbonSecondaryTextBrush" Color="#ABABAB" />
            <SolidColorBrush x:Key="RibbonIconBrush" Color="#E4E4E4" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundBrush" Color="#0F548C" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundHoverBrush" Color="#1A6FC0" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundPressedBrush" Color="#0C426E" />
            <SolidColorBrush x:Key="RibbonBackstageForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonStatusBarBrush" Color="#0F548C" />
            <SolidColorBrush x:Key="RibbonStatusBarTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="RibbonContentBrush" Color="#1F1F1F" />
        </ResourceDictionary>

        <!-- HighContrast Theme -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RibbonBorderBrush" Color="{ThemeResource SystemColorWindowFrameColor}" />
            <SolidColorBrush x:Key="RibbonSubtleBorderBrush" Color="{ThemeResource SystemColorWindowFrameColor}" />
            <SolidColorBrush x:Key="RibbonAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonAccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonSelectedTabBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RibbonCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RibbonLayerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="RibbonGroupHeaderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RibbonTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RibbonSecondaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="RibbonIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonBackstageBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonBackstageForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RibbonStatusBarBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RibbonStatusBarTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="RibbonContentBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
