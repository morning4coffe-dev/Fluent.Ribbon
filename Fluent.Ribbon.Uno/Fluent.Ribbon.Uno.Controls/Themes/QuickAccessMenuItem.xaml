<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:QuickAccessMenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:QuickAccessMenuItem">
                    <Border
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Checkmark, visible when the item is in the QAT -->
                            <TextBlock
                                Grid.Column="0"
                                Text="&#xE73E;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource RibbonTextBrush}"
                                Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ContentPresenter
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                Foreground="{ThemeResource RibbonTextBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
