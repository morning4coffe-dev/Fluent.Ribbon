<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonGroupBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource RibbonBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="4,2,4,0" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonGroupBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Large" />
                                <VisualState x:Name="Medium" />
                                <VisualState x:Name="Small" />
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="NormalContent.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_CollapsedButton.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Normal Content -->
                        <Border
                            x:Name="NormalContent"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel
                                    x:Name="PART_ItemsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Left" />

                                <Grid Grid.Row="1" Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        x:Name="PART_HeaderPresenter"
                                        Content="{TemplateBinding Header}"
                                        HorizontalAlignment="Center">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Text="{Binding}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource RibbonSecondaryTextBrush}"
                                                    TextAlignment="Center" />
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>

                                    <Button
                                        x:Name="LauncherButton"
                                        Grid.Column="1"
                                        Width="12"
                                        Height="12"
                                        Padding="0"
                                        Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Visibility="{Binding IsLauncherVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{TemplateBinding LauncherCommand}">
                                        <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource RibbonIconBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Collapsed Button -->
                        <Button
                            x:Name="PART_CollapsedButton"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Padding="8,4"
                            CornerRadius="3"
                            MinWidth="56">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <!-- Icon Glyph (preferred) -->
                                <FontIcon
                                    Glyph="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}"
                                    FontSize="32"
                                    Foreground="{ThemeResource RibbonIconBrush}"
                                    Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}}" />
                                <!-- Fallback image icon -->
                                <Image
                                    Source="{TemplateBinding Icon}"
                                    Width="32"
                                    Height="32"
                                    Stretch="Uniform"
                                    Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />
                                <TextBlock
                                    Text="{TemplateBinding Header}"
                                    Foreground="{ThemeResource RibbonTextBrush}"
                                    FontSize="11"
                                    TextAlignment="Center"
                                    Margin="0,2,0,0" />
                                <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource RibbonIconBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Popup for collapsed group expansion -->
                        <Popup x:Name="PART_CollapsedPopup" IsLightDismissEnabled="True">
                            <Border
                                Background="{ThemeResource RibbonBackgroundBrush}"
                                BorderBrush="{ThemeResource RibbonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,2,4,0">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <StackPanel>
                                    <StackPanel
                                        x:Name="PART_PopupItemsPanel"
                                        Orientation="Horizontal"
                                        MinHeight="94" />
                                    <TextBlock
                                        x:Name="PART_PopupHeaderText"
                                        FontSize="11"
                                        Foreground="{ThemeResource RibbonSecondaryTextBrush}"
                                        TextAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,2" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
