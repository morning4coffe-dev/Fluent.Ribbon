<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonGroupBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource RibbonSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Margin" Value="{ThemeResource RibbonGroupMargin}" />
        <Setter Property="Padding" Value="6,2,6,0" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonGroupBox">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Large" />
                                <VisualState x:Name="Medium" />
                                <VisualState x:Name="Small" />
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="NormalContent.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_CollapsedButton.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SimplifiedStates">
                                <VisualState x:Name="Classic" />
                                <VisualState x:Name="Simplified">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderRow.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_CollapsedButton.Padding" Value="6,1" />
                                        <Setter Target="PART_CollapsedGlyph.FontSize" Value="24" />
                                        <Setter Target="PART_CollapsedImage.Width" Value="24" />
                                        <Setter Target="PART_CollapsedImage.Height" Value="24" />
                                        <Setter Target="PART_CollapsedHeaderContentControl.FontSize" Value="10" />
                                        <Setter Target="PART_CollapsedHeaderContentControl.Margin" Value="0" />
                                        <Setter Target="PART_CollapsedChevron.FontSize" Value="7" />
                                        <Setter Target="PART_CollapsedChevron.Margin" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="KeyboardFocused">
                                    <VisualState.Setters>
                                        <Setter Target="CollapsedFocusVisual.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Normal Content -->
                        <Border
                            x:Name="NormalContent"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <fluent:RibbonGroupItemsPanel
                                    x:Name="PART_ItemsPanel"
                                    IsSimplified="{TemplateBinding IsSimplified}"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Left" />

                                <Grid x:Name="HeaderRow" Grid.Row="1" Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentControl
                                        x:Name="PART_HeaderPresenter"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        HorizontalAlignment="Center" />

                                    <fluent:Button
                                        x:Name="LauncherButton"
                                        Grid.Column="1"
                                        Width="{ThemeResource RibbonCompactTargetSize}"
                                        Height="{ThemeResource RibbonCompactTargetSize}"
                                        Padding="2"
                                        Margin="4,0,0,0"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        Foreground="{ThemeResource RibbonIconBrush}"
                                        BorderThickness="0"
                                        UseSystemFocusVisuals="True"
                                        FocusVisualMargin="-2"
                                        Visibility="{Binding IsLauncherVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{TemplateBinding LauncherCommand}">
                                        <fluent:Button.Template>
                                            <ControlTemplate TargetType="fluent:Button">
                                                <Border
                                                    x:Name="LauncherRoot"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"
                                                    Control.IsTemplateFocusTarget="True">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="LauncherRoot.Background" Value="{ThemeResource RibbonHoverBrush}" />
                                                                    <Setter Target="LauncherContent.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="LauncherRoot.Background" Value="{ThemeResource RibbonPressedBrush}" />
                                                                    <Setter Target="LauncherContent.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled">
                                                                <VisualState.Setters>
                                                                    <Setter Target="LauncherContent.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <ContentPresenter
                                                        x:Name="LauncherContent"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        Content="{TemplateBinding Content}" />
                                                </Border>
                                            </ControlTemplate>
                                        </fluent:Button.Template>
                                        <FontIcon Glyph="&#xE70D;" FontSize="8" />
                                    </fluent:Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Collapsed Button -->
                        <Button
                            x:Name="PART_CollapsedButton"
                            Visibility="Collapsed"
                            Background="Transparent"
                            Foreground="{ThemeResource RibbonIconBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Padding="8,4"
                            CornerRadius="4"
                            MinWidth="56"
                            MinHeight="{ThemeResource RibbonCompactTargetSize}"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            AutomationProperties.AccessibilityView="Raw">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="CollapsedRoot"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="CollapsedRoot.Background" Value="{ThemeResource RibbonHoverBrush}" />
                                                        <Setter Target="CollapsedContentPresenter.Foreground" Value="{ThemeResource RibbonHoverForegroundBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="CollapsedRoot.Background" Value="{ThemeResource RibbonPressedBrush}" />
                                                        <Setter Target="CollapsedContentPresenter.Foreground" Value="{ThemeResource RibbonPressedForegroundBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <VisualState.Setters>
                                                        <Setter Target="CollapsedContentPresenter.Foreground" Value="{ThemeResource RibbonDisabledForegroundBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter
                                            x:Name="CollapsedContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            Foreground="{TemplateBinding Foreground}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <!-- Icon Glyph (preferred) -->
                                <FontIcon
                                    x:Name="PART_CollapsedGlyph"
                                    Glyph="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}}"
                                    FontSize="32"
                                    Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}}" />
                                <!-- Fallback image icon -->
                                <Image
                                    x:Name="PART_CollapsedImage"
                                    Source="{TemplateBinding CollapsedIcon}"
                                    Width="32"
                                    Height="32"
                                    Stretch="Uniform"
                                    Visibility="{Binding CollapsedIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />
                                <ContentControl
                                    x:Name="PART_CollapsedHeaderContentControl"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    FontSize="11"
                                    HorizontalContentAlignment="Center"
                                    Margin="0,2,0,0" />
                                <FontIcon
                                    x:Name="PART_CollapsedChevron"
                                    Glyph="&#xE70D;"
                                    FontSize="8"
                                    Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>

                        <Border
                            x:Name="CollapsedFocusVisual"
                            BorderBrush="{ThemeResource SystemControlFocusVisualPrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            Margin="-2"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />

                        <!-- Popup for collapsed group expansion -->
                        <Popup x:Name="PART_CollapsedPopup" IsLightDismissEnabled="True">
                            <Border
                                Background="{ThemeResource RibbonBackgroundBrush}"
                                BorderBrush="{ThemeResource RibbonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,4,6,2"
                                Translation="0,0,32">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <StackPanel>
                                    <StackPanel
                                        x:Name="PART_PopupItemsPanel"
                                        Orientation="Horizontal"
                                        MinHeight="{ThemeResource RibbonContentHeight}" />
                                    <TextBlock
                                        x:Name="PART_PopupHeaderText"
                                        FontSize="11"
                                        Foreground="{ThemeResource RibbonSecondaryTextBrush}"
                                        TextAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,2" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
