<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">

    <Style TargetType="fluent:RibbonTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{ThemeResource RibbonButtonPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{ThemeResource RibbonControlMinHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fluent:RibbonTextBox">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Large">
                                    <VisualState.Setters>
                                        <Setter Target="GlyphIcon.FontSize" Value="16" />
                                        <Setter Target="HeaderText.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Medium">
                                    <VisualState.Setters>
                                        <Setter Target="GlyphIcon.FontSize" Value="16" />
                                        <Setter Target="HeaderText.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Small">
                                    <VisualState.Setters>
                                        <Setter Target="GlyphIcon.FontSize" Value="14" />
                                        <Setter Target="HeaderText.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Glyph Icon -->
                                <FontIcon
                                    x:Name="GlyphIcon"
                                    Glyph="{TemplateBinding IconGlyph}"
                                    FontSize="16"
                                    Foreground="{ThemeResource RibbonIconBrush}"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IconGlyph, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyStringToCollapsedConverter}, FallbackValue=Collapsed}" />

                                <!-- Image Icon -->
                                <Image
                                    Source="{TemplateBinding MediumIcon}"
                                    Width="16"
                                    Height="16"
                                    Stretch="Uniform"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding MediumIcon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />

                                <!-- Header -->
                                <TextBlock
                                    x:Name="HeaderText"
                                    Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                    Foreground="{ThemeResource RibbonTextBrush}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>

                            <!-- TextBox input area -->
                            <TextBox
                                x:Name="PART_TextBox"
                                Grid.Column="1"
                                MinWidth="{TemplateBinding InputWidth}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Padding="{ThemeResource RibbonButtonPadding}"
                                FontSize="12"
                                MinHeight="{ThemeResource RibbonControlMinHeight}"
                                Background="{ThemeResource TextControlBackground}"
                                BorderBrush="{ThemeResource TextControlBorderBrush}"
                                BorderThickness="{ThemeResource TextControlBorderThemeThickness}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
