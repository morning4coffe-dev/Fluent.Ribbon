<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core ribbon templates expose only a few sizing resources today, so this opt-in dictionary
         overrides the keyed ones and publishes modern keys demos can consume without changing core controls. -->
    <x:Double x:Key="RibbonContentHeight">112</x:Double>
    <x:Double x:Key="RibbonTabHeight">36</x:Double>
    <Thickness x:Key="RibbonGroupMargin">4,0,4,0</Thickness>
    <Thickness x:Key="RibbonButtonPadding">8,6</Thickness>
    <x:Double x:Key="ModernTouchTargetMinHeight">44</x:Double>
    <Thickness x:Key="ModernTouchTargetPadding">8,6</Thickness>
    <x:Double x:Key="ModernTouchSpacing">8</x:Double>
</ResourceDictionary>
