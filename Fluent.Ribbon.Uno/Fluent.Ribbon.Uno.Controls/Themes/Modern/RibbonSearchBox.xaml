<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modernControls="using:Fluent.Modern.Controls">

    <Style TargetType="modernControls:RibbonSearchBox">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="modernControls:RibbonSearchBox">
                    <AutoSuggestBox
                        x:Name="PART_AutoSuggestBox"
                        MinWidth="220"
                        MaxWidth="360"
                        QueryIcon="Find">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="0,4">
                                    <TextBlock
                                        Text="{Binding DisplayName}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding Location}"
                                        Opacity="0.7"
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
