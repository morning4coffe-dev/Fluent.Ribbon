<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modernControls="using:Fluent.Modern.Controls">

    <Style TargetType="modernControls:ModernIconPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="modernControls:ModernIconPresenter">
                    <IconSourceElement
                        x:Name="PART_IconSourceElement"
                        Width="{TemplateBinding ActualIconDimension}"
                        Height="{TemplateBinding ActualIconDimension}"
                        IconSource="{TemplateBinding Source}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
