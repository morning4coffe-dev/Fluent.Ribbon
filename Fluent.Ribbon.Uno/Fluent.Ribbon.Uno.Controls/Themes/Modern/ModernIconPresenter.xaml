<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modernControls="using:Fluent.Modern.Controls">

    <Style TargetType="modernControls:ModernIconPresenter">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="modernControls:ModernIconPresenter">
                    <ContentPresenter
                        x:Name="PART_IconHost"
                        Width="{TemplateBinding ActualIconDimension}"
                        Height="{TemplateBinding ActualIconDimension}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
