<Application x:Class="FluentRibbon.Uno.Showcase.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Load Fluent Ribbon control styles -->
        <ResourceDictionary Source="ms-appx:///Fluent.Ribbon.Uno/Themes/Generic.xaml" />
        <ResourceDictionary Source="ms-appx:///Fluent.Ribbon.Uno/Themes/Modern/Modern.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Add resources here -->

      <!--
        Contextual tab groups are colour-coded by context (as in Office), so the sample sets an
        explicit accent. Defining it per theme keeps that identity in Light/Dark while deferring
        to system colours under High Contrast, where a fixed white-on-blue would be unreadable.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TableToolsAccentBrush" Color="#0F6CBD" />
          <SolidColorBrush x:Key="TableToolsAccentForegroundBrush" Color="White" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TableToolsAccentBrush" Color="#2B88D8" />
          <SolidColorBrush x:Key="TableToolsAccentForegroundBrush" Color="#1B1B1B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="TableToolsAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="TableToolsAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

    </ResourceDictionary>
  </Application.Resources>

</Application>
