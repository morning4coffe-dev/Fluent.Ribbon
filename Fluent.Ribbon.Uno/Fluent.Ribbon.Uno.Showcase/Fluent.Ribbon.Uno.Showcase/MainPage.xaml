                                        <fluent:RibbonMenuItem AutomationProperties.AutomationId="MniRed" Header="Red" IconGlyph="&#xEA3A;" fluent:KeyTip.Keys="R" />
                                    </fluent:RibbonSplitButton.Items>
                                </fluent:RibbonSplitButton>
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnGreyNormalKeyTips" Header="Grey" Size="Large" IconGlyph="&#xE790;" Foreground="#9E9E9E" fluent:KeyTip.Keys="G" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnOrange" Header="Orange" Size="Large" IconGlyph="&#xE790;" Foreground="#FF8C00" fluent:KeyTip.Keys="O" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnPink" Header="Pink" Size="Large" IconGlyph="&#xE790;" Foreground="#E3008C" fluent:KeyTip.Keys="P" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnGray1" Header="Gray 1" Size="Medium" IconGlyph="&#xE790;" Foreground="#9E9E9E" fluent:KeyTip.Keys="X1" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnGray2" Header="Gray 2" Size="Medium" IconGlyph="&#xE790;" Foreground="#9E9E9E" fluent:KeyTip.Keys="X2" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnGray3" Header="Gray 3" Size="Medium" IconGlyph="&#xE790;" Foreground="#9E9E9E" fluent:KeyTip.Keys="X3" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <fluent:RibbonGroupBox Header="Custom KeyTip placement">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnCenter" Header="Center" Size="Large" IconGlyph="&#xE790;" Foreground="#107C10"
                                                     fluent:KeyTip.Keys="C" fluent:KeyTip.AutoPlacement="False"
                                                     fluent:KeyTip.HorizontalAlignment="Center" fluent:KeyTip.VerticalAlignment="Center" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnLeft" Header="Left" Size="Large" IconGlyph="&#xE790;" Foreground="#9E9E9E"
                                                     fluent:KeyTip.Keys="L" fluent:KeyTip.AutoPlacement="False"
                                                     fluent:KeyTip.HorizontalAlignment="Left" fluent:KeyTip.VerticalAlignment="Center" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnTop" Header="Top" Size="Large" IconGlyph="&#xE790;" Foreground="#FFB900"
                                                     fluent:KeyTip.Keys="T" fluent:KeyTip.AutoPlacement="False"
                                                     fluent:KeyTip.HorizontalAlignment="Center" fluent:KeyTip.VerticalAlignment="Top" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnLeftTopMargin" Header="Left, Top, Margin" Size="Large" IconGlyph="&#xE790;" Foreground="#FFB900"
                                                     fluent:KeyTip.Keys="LTM" fluent:KeyTip.AutoPlacement="False"
                                                     fluent:KeyTip.HorizontalAlignment="Left" fluent:KeyTip.VerticalAlignment="Top"
                                                     fluent:KeyTip.Margin="40,0,0,0" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>
                    </fluent:RibbonTab.Groups>
                </fluent:RibbonTab>

                <!-- Binding Tab (faithful clone of WPF Showcase "Binding") -->
                <fluent:RibbonTab AutomationProperties.AutomationId="TabBinding" Header="Binding" fluent:KeyTip.Keys="B">
                    <fluent:RibbonTab.Groups>
                        <fluent:RibbonGroupBox x:Name="BoundItemsGroup" Header="Bound ItemsSource" IconGlyph="&#xE71D;" />
                    </fluent:RibbonTab.Groups>
                </fluent:RibbonTab>

                <!-- Layout Tab (faithful clone of WPF Showcase "Layout") -->
                <fluent:RibbonTab AutomationProperties.AutomationId="TabLayout" Header="Layout" fluent:KeyTip.Keys="L">
                    <fluent:RibbonTab.Groups>
                        <fluent:RibbonGroupBox Header="LongLongGroup" IsLauncherVisible="False">
                            <fluent:RibbonGroupBox.Items>
                                <DatePicker />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <fluent:RibbonGroupBox x:Name="LayoutPasteGroup" Header="LongLongGroup"
                                               IsLauncherVisible="True" LauncherClick="OnLauncherClick">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnButton" Header="Button" Size="Large" IconGlyph="&#xE77F;" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnButtonLongLongGroup" Header="Button" Size="Large" IconGlyph="&#xE77F;" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnButton2" Header="Button" Size="Large" IconGlyph="&#xE77F;" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnButton3" Header="Button" Size="Large" IconGlyph="&#xE77F;" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnButton4" Header="Button" Size="Large" IconGlyph="&#xE77F;" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <fluent:RibbonGroupBox Header="Toggles" IconGlyph="&#xE769;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonToggleButton AutomationProperties.AutomationId="TglPause" Header="Pause" Size="Medium" IconGlyph="&#xE769;" />
                                <fluent:RibbonToggleButton AutomationProperties.AutomationId="TglButtonLongTextGggggggGggg" Header="Button long text ggggggg gggg" Size="Medium" IconGlyph="&#xE8E8;" />
                                <fluent:RibbonToggleButton AutomationProperties.AutomationId="TglButtonLongTextGggggggGgggToggles" Header="Button long text ggggggg gggg" Size="Large" IconGlyph="&#xE8E8;" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>
                    </fluent:RibbonTab.Groups>
                </fluent:RibbonTab>

                <!-- Contextual Tab: Table Design -->
                <fluent:RibbonTab AutomationProperties.AutomationId="TabDesign" Header="Design" ContextualTabGroupName="Table Tools" fluent:KeyTip.Keys="JT">
                    <fluent:RibbonTab.Groups>
                        <fluent:RibbonGroupBox Header="Table Styles" IconGlyph="&#xE80A;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnShading" Header="Shading" Size="Large" IconGlyph="&#xE790;" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnBorders" Header="Borders" Size="Large" IconGlyph="&#xE80A;" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>
                        <fluent:RibbonGroupBox Header="Draw Borders" IconGlyph="&#xED63;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnDrawTable" Header="Draw Table" Size="Medium" IconGlyph="&#xED63;" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnEraser" Header="Eraser" Size="Medium" IconGlyph="&#xE75C;" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>
                    </fluent:RibbonTab.Groups>
                </fluent:RibbonTab>
            </fluent:Ribbon.Tabs>
        </fluent:Ribbon>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <ScrollViewer>
                <StackPanel Padding="20" Spacing="24">
                    <!-- Hero Section -->
                    <Border CornerRadius="12" Padding="32,26" HorizontalAlignment="Stretch">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A66C2" Offset="0" />
                                <GradientStop Color="#0091D5" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" Spacing="12" MaxWidth="860">
                            <TextBlock
                                Text="Fluent.Ribbon.Uno"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="A cross-platform, Office-style Ribbon for Uno Platform &amp; WinUI 3"
                                FontSize="15"
                                Foreground="#EAF4FC"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                MaxWidth="560"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="Windows  ·  WebAssembly  ·  iOS  ·  Android  ·  macOS  ·  Linux"
                                FontSize="12"
                                Foreground="#CFE6F7"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="App Menu · Quick Access Toolbar · Contextual Tabs · Galleries · Backstage · Spinner · 20 Languages"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#DCEBF8"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                MaxWidth="640"
                                TextWrapping="Wrap" />
                            <!--
                                A horizontal StackPanel never wraps, so at narrow widths this row
                                overflowed both edges and the last action became unreachable. The
                                library's own wrap panel reflows it into rows instead. Spacing moves
                                onto the children because this panel has no Spacing property.
                            -->
                            <fluent:RibbonGroupBoxWrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Button x:Name="ToggleTableToolsButton" AutomationProperties.AutomationId="ToggleTableToolsButton" Content="Toggle Table Tools" Click="OnToggleTableTools" Padding="12,6" Margin="4" />
                                <Button x:Name="OpenBackstageButton" AutomationProperties.AutomationId="OpenBackstageButton" Content="Open Backstage" Click="OnOpenBackstage" Padding="12,6" Margin="4" />
                                <Button x:Name="ToggleMinimizeButton" AutomationProperties.AutomationId="ToggleMinimizeButton" Content="Toggle Minimize" Click="OnToggleMinimize" Padding="12,6" Margin="4" />
                                <Button x:Name="ToggleSimplifiedButton" AutomationProperties.AutomationId="ToggleSimplifiedButton" Content="Toggle Simplified" Click="OnToggleSimplified" Padding="12,6" Margin="4" />
                                <ToggleButton x:Name="DarkModeButton" AutomationProperties.AutomationId="DarkModeButton" Content="Dark Mode" Click="OnToggleTheme" Padding="12,6" Margin="4" />
                                <ToggleButton x:Name="RtlModeButton" AutomationProperties.AutomationId="RtlModeButton" Content="RTL" Click="OnToggleRtl" Padding="12,6" Margin="4" />
                            </fluent:RibbonGroupBoxWrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Ported Controls Showcase Section -->
                    <TextBlock Text="Ported Controls Showcase" Style="{StaticResource SectionHeading}" />

                    <!-- ColorGallery -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ColorGallery" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="A gallery control for color selection with standard colors." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <!-- Left-aligned so the gallery takes its natural width instead of
                                 stretching its Automatic / No Color / More Colors rows across the
                                 whole card. -->
                            <fluent:ColorGallery x:Name="SampleColorGallery" Columns="10"
                                                  HorizontalAlignment="Left"
                                                  IsAutomaticColorButtonVisible="True"
                                                  IsNoColorButtonVisible="True" />
                            <TextBlock x:Name="SelectedColorText" Text="Selected: (none)" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- TwoLineLabel -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="TwoLineLabel" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="A label that can split text across two lines, with an optional glyph indicator." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <fluent:TwoLineLabel Text="Two Line Demo" HasTwoLines="True" HasGlyph="True" />
                                <fluent:TwoLineLabel Text="Single Line Demo" HasTwoLines="False" HasGlyph="False" />
                                <fluent:TwoLineLabel Text="With Glyph Only" HasTwoLines="False" HasGlyph="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- IconPresenter -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="IconPresenter" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Multi-size icon presenter that adapts to Small, Medium, and Large sizes." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <fluent:IconPresenter IconSize="Small" />
                                    <TextBlock Text="Small" FontSize="10" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <fluent:IconPresenter IconSize="Medium" />
                                    <TextBlock Text="Medium" FontSize="10" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <fluent:IconPresenter IconSize="Large" />
                                    <TextBlock Text="Large" FontSize="10" HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TransitioningControl -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="TransitioningControl" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Animated content transitions when content changes." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:TransitioningControl x:Name="SampleTransition" IsTransitionEnabled="True" Height="60">
                                <fluent:TransitioningControl.Content>
                                    <TextBlock Text="Click 'Change Content' to see transition" FontSize="14" VerticalAlignment="Center" />
                                </fluent:TransitioningControl.Content>
                            </fluent:TransitioningControl>
                            <Button Content="Change Content" Click="OnChangeTransitionContent" Padding="12,6" />
                        </StackPanel>
                    </Border>

                    <!-- GalleryGroupContainer -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="GalleryGroupContainer" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="A container that groups gallery items with an optional header." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:GalleryGroupContainer Header="Color Swatches" IsHeadered="True"
                                                            Orientation="Horizontal"
                                                            ItemWidth="48" ItemHeight="48" MaxItemsInRow="6">
                                <fluent:GalleryGroupContainer.Items>
                                    <Border Background="#0078D4" Width="40" Height="40" CornerRadius="4" />
                                    <Border Background="#107C10" Width="40" Height="40" CornerRadius="4" />
                                    <Border Background="#E81123" Width="40" Height="40" CornerRadius="4" />
                                    <Border Background="#FF8C00" Width="40" Height="40" CornerRadius="4" />
                                    <Border Background="#5C2D91" Width="40" Height="40" CornerRadius="4" />
                                    <Border Background="#008575" Width="40" Height="40" CornerRadius="4" />
                                </fluent:GalleryGroupContainer.Items>
                            </fluent:GalleryGroupContainer>
                            <fluent:GalleryGroupContainer Header="Shape Presets" IsHeadered="True"
                                                            Orientation="Horizontal"
                                                            ItemWidth="48" ItemHeight="48" MaxItemsInRow="6">
                                <fluent:GalleryGroupContainer.Items>
                                    <Border Background="#0078D4" Width="40" Height="40" CornerRadius="20" />
                                    <Border Background="#107C10" Width="40" Height="40" CornerRadius="0" />
                                    <Border Background="#E81123" Width="40" Height="40" CornerRadius="8" />
                                    <Border Background="#FF8C00" Width="40" Height="40" CornerRadius="20" />
                                </fluent:GalleryGroupContainer.Items>
                            </fluent:GalleryGroupContainer>
                        </StackPanel>
                    </Border>

                    <!-- RibbonToolBar -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="RibbonToolBar" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="A toolbar that arranges items according to declarative layout definitions (rows x columns)." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <TextBlock Text="See the 'Ported Controls' ribbon tab for a live example in the ribbon." FontSize="12"
                                       FontStyle="Italic" Foreground="{ThemeResource RibbonAccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- BackstageTabControl + BackstageButton -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="BackstageTabControl &amp; BackstageButton" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Standalone backstage tab control with navigation buttons." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:BackstageTabControl ItemsPanelMinWidth="150" IsBackButtonVisible="False" Height="200">
                                <fluent:BackstageTabControl.Items>
                                    <fluent:BackstageButton AutomationProperties.AutomationId="BsbAction1" Header="Action 1" />
                                    <fluent:BackstageButton AutomationProperties.AutomationId="BsbAction2" Header="Action 2" />
                                </fluent:BackstageTabControl.Items>
                            </fluent:BackstageTabControl>
                        </StackPanel>
                    </Border>

                    <!-- StartScreen -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="StartScreen" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="A two-pane start screen with left navigation and right content." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:StartScreen x:Name="SampleStartScreen" IsOpen="True" LeftPaneWidth="200" Height="250">
                                <fluent:StartScreen.LeftPaneContent>
                                    <StackPanel Spacing="8" Padding="12" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                                        <TextBlock Text="Start" FontSize="20" FontWeight="Bold" />
                                        <TextBlock Text="Recent" FontSize="14" />
                                        <TextBlock Text="Document1.docx" FontSize="12" Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                                        <TextBlock Text="Report.docx" FontSize="12" Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                                        <TextBlock Text="Notes.txt" FontSize="12" Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                                    </StackPanel>
                                </fluent:StartScreen.LeftPaneContent>
                                <fluent:StartScreen.Content>
                                    <StackPanel Spacing="12" Padding="20" VerticalAlignment="Center">
                                        <TextBlock Text="Welcome!" FontSize="24" FontWeight="Bold" />
                                        <TextBlock Text="Choose a recent document or create a new one." FontSize="14" TextWrapping="Wrap" />
                                        <Button Content="New Blank Document" Padding="12,6" />
                                    </StackPanel>
                                </fluent:StartScreen.Content>
                            </fluent:StartScreen>
                        </StackPanel>
                    </Border>

                    <!-- ResizeableContentControl -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ResizeableContentControl" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="A content container that the user can resize by dragging." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:ResizeableContentControl CanResizeBothDirections="True" Width="300" Height="120">
                                <fluent:ResizeableContentControl.Content>
                                    <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4" Padding="12">
                                        <TextBlock Text="Drag edges to resize this area" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </fluent:ResizeableContentControl.Content>
                            </fluent:ResizeableContentControl>
                        </StackPanel>
                    </Border>

                    <!-- RibbonScrollViewer -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="RibbonScrollViewer" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Horizontal scroller with left/right chevrons for overflowing ribbon content." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:RibbonScrollViewer Width="320" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="One" />
                                    <Button Content="Two" />
                                    <Button Content="Three" />
                                    <Button Content="Four" />
                                    <Button Content="Five" />
                                    <Button Content="Six" />
                                    <Button Content="Seven" />
                                    <Button Content="Eight" />
                                </StackPanel>
                            </fluent:RibbonScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- RibbonTitleBar -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="RibbonTitleBar" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Title bar hosting a quick access toolbar, contextual group area, and centered title." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:RibbonTitleBar Header="Document1 - Fluent.Ribbon.Uno" Height="36">
                                <fluent:RibbonTitleBar.QuickAccessToolBar>
                                    <fluent:QuickAccessToolBar>
                                        <fluent:QuickAccessToolBar.Items>
                                            <fluent:RibbonButton AutomationProperties.AutomationId="BtnSave" AutomationProperties.Name="Save" Size="Small" IconGlyph="&#xE74E;" ToolTipService.ToolTip="Save" />
                                            <fluent:RibbonButton AutomationProperties.AutomationId="BtnUndo" AutomationProperties.Name="Undo" Size="Small" IconGlyph="&#xE7A7;" ToolTipService.ToolTip="Undo" />
                                        </fluent:QuickAccessToolBar.Items>
                                    </fluent:QuickAccessToolBar>
                                </fluent:RibbonTitleBar.QuickAccessToolBar>
                            </fluent:RibbonTitleBar>
                        </StackPanel>
                    </Border>

                    <!-- RibbonToolBarControlGroup -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="RibbonToolBarControlGroup" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Groups related toolbar controls so they render as a single segmented cluster." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:RibbonToolBarControlGroup HorizontalAlignment="Left">
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnLeft2" Size="Small" Header="Left" IconGlyph="&#xE8B8;" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnCenter2" Size="Small" Header="Center" IconGlyph="&#xE8BA;" />
                                <fluent:RibbonButton AutomationProperties.AutomationId="BtnRight" Size="Small" Header="Right" IconGlyph="&#xE8B9;" />
                            </fluent:RibbonToolBarControlGroup>
                        </StackPanel>
                    </Border>

                    <!-- Checkable Menu Items -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="StatusBarMenuItem &amp; QuickAccessMenuItem" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Checkable menu entries used to toggle status-bar fields and quick-access commands. Click to toggle the check mark." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <StackPanel Spacing="2" Width="240" HorizontalAlignment="Left">
                                <fluent:StatusBarMenuItem AutomationProperties.AutomationId="SbmWordCount" Header="Word Count" IsChecked="True" />
                                <fluent:StatusBarMenuItem AutomationProperties.AutomationId="SbmZoomSlider" Header="Zoom Slider" IsChecked="True" />
                                <fluent:StatusBarMenuItem AutomationProperties.AutomationId="SbmCapsLock" Header="Caps Lock" IsChecked="False" />
                                <fluent:QuickAccessMenuItem AutomationProperties.AutomationId="QamSave" Header="Save" IsChecked="True" />
                                <fluent:QuickAccessMenuItem AutomationProperties.AutomationId="QamPrintPreview" Header="Print Preview" IsChecked="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- KeyTips -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="KeyTips (Alt navigation)" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Press Alt (or F10) while the ribbon is focused to show access keys, then type them to activate. Try Alt, then H (Home), V (Paste); Esc goes back." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Localization Demo -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Localization" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="The ribbon supports 20 languages: English, German, French, Spanish, Chinese, Japanese, Portuguese, Russian, Italian, Dutch, Polish, Korean, Turkish, Arabic, Czech, Swedish, Danish, Norwegian, Finnish, Hungarian." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="English" Click="OnSetLanguageEnglish" Padding="8,4" />
                                <Button Content="Deutsch" Click="OnSetLanguageGerman" Padding="8,4" />
                                <Button Content="Français" Click="OnSetLanguageFrench" Padding="8,4" />
                                <Button Content="Español" Click="OnSetLanguageSpanish" Padding="8,4" />
                                <Button Content="中文" Click="OnSetLanguageChinese" Padding="8,4" />
                                <Button Content="日本語" Click="OnSetLanguageJapanese" Padding="8,4" />
                            </StackPanel>
                            <TextBlock x:Name="LocalizationSample" Text="" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Spacer -->
                    <Border Height="20" />

                    <!-- ScreenTip Showcase -->
                    <Border Style="{StaticResource ShowcaseCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ScreenTip (Enhanced Tooltip)" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Hover over the Paste, Find, and Zoom buttons in the ribbon to see enhanced tooltips with Title, Description text, and DisableReason." FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="ScreenTips can also be used as standalone controls:" FontSize="12"
                                       Foreground="{ThemeResource RibbonSecondaryTextBrush}" />
                            <fluent:ScreenTip Title="Example ScreenTip" Text="This is a standalone ScreenTip component showing how it renders outside of a tooltip context." DisableReason="This shows when the control is disabled." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <fluent:RibbonStatusBar Grid.Row="2">
            <fluent:RibbonStatusBar.Items>
                <fluent:RibbonStatusBarItem>
                    <TextBlock Text="Ready" Foreground="{ThemeResource RibbonStatusBarTextBrush}" FontSize="12" />
                </fluent:RibbonStatusBarItem>
                <fluent:RibbonStatusBarItem>
                    <TextBlock Text="Page 1 of 1" Foreground="{ThemeResource RibbonStatusBarTextBrush}" FontSize="12" />
                </fluent:RibbonStatusBarItem>
            </fluent:RibbonStatusBar.Items>
            <fluent:RibbonStatusBar.RightItems>
                <fluent:RibbonStatusBarItem>
                    <TextBlock Text="Words: 0" Foreground="{ThemeResource RibbonStatusBarTextBrush}" FontSize="12" />
                </fluent:RibbonStatusBarItem>
                <fluent:RibbonStatusBarItem>
                    <TextBlock Text="100%" Foreground="{ThemeResource RibbonStatusBarTextBrush}" FontSize="12" />
                </fluent:RibbonStatusBarItem>
            </fluent:RibbonStatusBar.RightItems>
        </fluent:RibbonStatusBar>

        <!-- Backstage Overlay (spans all rows to cover the full page) -->
        <fluent:Backstage
            x:Name="BackstageView"
            Grid.RowSpan="3"
            Header="File">
            <fluent:Backstage.Content>
                <fluent:BackstageTabControl BackButtonUid="BackstageView.Back">
                    <fluent:BackstageTabControl.Items>
                        <fluent:BackstageButton AutomationProperties.AutomationId="BsbSave" Header="Save" KeyTip="S">
                            <fluent:BackstageButton.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </fluent:BackstageButton.Icon>
                        </fluent:BackstageButton>

                        <fluent:BackstageButton AutomationProperties.AutomationId="BsbSaveAs" Header="Save As" KeyTip="A">
                            <fluent:BackstageButton.Icon>
                                <FontIcon Glyph="&#xE792;" />
                            </fluent:BackstageButton.Icon>
                        </fluent:BackstageButton>

                        <fluent:BackstageTabItem AutomationProperties.AutomationId="BstiDisabled" Header="Disabled" IsEnabled="False" />

                        <fluent:BackstageTabItem AutomationProperties.AutomationId="BstiHome" Header="Home" IconGlyph="&#xE80F;" KeyTip="T">
                            <fluent:BackstageTabItem.Content>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="This is a BackstageTabItem with some sample content." />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <fluent:RibbonButton AutomationProperties.AutomationId="BtnButtonWithBoundCommand"
                                            Header="Button with bound command"
                                            Size="Medium"
                                            IconGlyph="&#xE8A7;" />
                                        <fluent:RibbonButton
                                            x:Name="backstageHomeButton"
                                            Header="Button"
                                            Size="Medium"
                                            IconGlyph="&#xE8B7;"
                                            fluent:KeyTip.Keys="BH" />
                                        <fluent:RibbonToggleButton AutomationProperties.AutomationId="TglToggle"
                                            Header="Toggle"
                                            Size="Medium"
                                            IconGlyph="&#xE7C9;" />
                                        <fluent:RibbonDropDownButton AutomationProperties.AutomationId="DdbDropDownButtonHome"
                                            Header="DropDownButton"
                                            Size="Medium"
                                            IconGlyph="&#xE70D;">
                                            <fluent:RibbonDropDownButton.Items>
                                                <fluent:RibbonMenuItem AutomationProperties.AutomationId="MniBlueHome" Header="Blue" />
                                                <fluent:RibbonMenuItem AutomationProperties.AutomationId="MniGray" Header="Gray" />
                                                <fluent:RibbonMenuItem AutomationProperties.AutomationId="MniGreenHome" Header="Green" />
                                            </fluent:RibbonDropDownButton.Items>
                                        </fluent:RibbonDropDownButton>
                                        <fluent:RibbonComboBox AutomationProperties.AutomationId="CmbComboBox"
                                            Header="ComboBox"
                                            InputWidth="70"
                                            SelectedIndex="0">
                                            <x:String>1</x:String>
                                            <x:String>2</x:String>
                                            <x:String>3</x:String>
                                            <x:String>4</x:String>
                                            <x:String>5</x:String>
                                        </fluent:RibbonComboBox>
                                        <fluent:RibbonSpinner AutomationProperties.AutomationId="SpnSpinner"
                                            Header="Spinner"
                                            InputWidth="50"
                                            Format="0"
                                            Value="1" />
                                    </StackPanel>

                                    <TextBlock
                                        MaxWidth="1100"
                                        TextWrapping="Wrap"
                                        Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer mi elit, efficitur a sapien sit amet, euismod tempus quam. Aenean porta nisl id erat eleifend, vehicula convallis orci posuere. Maecenas id eleifend magna. Aenean quis nunc id odio tristique scelerisque et eu felis. Donec vestibulum augue sit amet dignissim feugiat. Pellentesque dignissim maximus lacinia. Maecenas dictum velit ut dui tempor imperdiet. Maecenas mi tortor, hendrerit consequat augue eget, rhoncus efficitur nunc. Cras in risus eu mi efficitur posuere et sit amet turpis. Sed sit amet auctor felis. Sed ultricies dui urna, in venenatis dui volutpat in. Curabitur congue congue scelerisque." />
                                </StackPanel>
                            </fluent:BackstageTabItem.Content>
                        </fluent:BackstageTabItem>

                        <fluent:SeparatorTabItem Header="Separator" />

                        <fluent:BackstageTabItem AutomationProperties.AutomationId="BstiRecent" Header="Recent" IconGlyph="&#xE81C;" KeyTip="R">
                            <fluent:BackstageTabItem.Content>
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Recent" />
                                    <TextBlock Text="Test1" FontWeight="SemiBold" />
                                    <Button
                                        x:Name="backstageRecentButton"
                                        Content="1"
                                        HorizontalAlignment="Stretch"
                                        fluent:KeyTip.Keys="R1" />
                                    <Button Content="2" HorizontalAlignment="Stretch" />
                                    <Button Content="3" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Test2" FontWeight="SemiBold" />
                                    <Button Content="4" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </fluent:BackstageTabItem.Content>
                        </fluent:BackstageTabItem>

                        <fluent:BackstageButton AutomationProperties.AutomationId="BsbExit" Header="Exit" KeyTip="X">
                            <fluent:BackstageButton.Icon>
                                <FontIcon Glyph="&#xE8BB;" />
                            </fluent:BackstageButton.Icon>
                        </fluent:BackstageButton>
                    </fluent:BackstageTabControl.Items>
                </fluent:BackstageTabControl>
            </fluent:Backstage.Content>
        </fluent:Backstage>
    </Grid>
</Page>
