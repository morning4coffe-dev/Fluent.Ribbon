<Page x:Class="FluentRibbon.Uno.Showcase.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FluentRibbon.Uno.Showcase"
      xmlns:fluent="using:Fluent"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Elevated "card" surface for the showcase sections -->
        <Style x:Key="ShowcaseCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource RibbonCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource RibbonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <!-- Section heading -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource RibbonTextBrush}" />
            <Setter Property="Margin" Value="4,8,0,0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ribbon Control -->
        <fluent:Ribbon x:Name="MainRibbon" Title="Fluent Ribbon Uno - Showcase"
                       IsQuickAccessToolBarVisible="True"
                       ShowQuickAccessToolBarAboveRibbon="True">
            <!-- Application Menu -->
            <fluent:Ribbon.Menu>
                <fluent:ApplicationMenu Header="File" IconGlyph="&#xE7C3;"
                                         RightPaneWidth="260">
                    <fluent:ApplicationMenu.Items>
                        <fluent:RibbonMenuItem Header="New" IconGlyph="&#xE8A5;" Description="Create a new document" />
                        <fluent:RibbonMenuItem Header="Open" IconGlyph="&#xE838;" Description="Open an existing document" />
                        <fluent:RibbonMenuItem Header="Save" IconGlyph="&#xE74E;" />
                        <fluent:RibbonMenuItem Header="Save As" IconGlyph="&#xE792;" Description="Save to a different file" />
                        <fluent:RibbonSeparator Orientation="Horizontal" />
                        <fluent:RibbonMenuItem Header="Print" IconGlyph="&#xE749;" Description="Print the document" />
                        <fluent:RibbonMenuItem Header="Export" IconGlyph="&#xEDE1;" Description="Export to another format" />
                        <fluent:RibbonSeparator Orientation="Horizontal" />
                        <fluent:RibbonMenuItem
                            Header="Backstage"
                            IconGlyph="&#xE7C3;"
                            Description="Open the WPF-style backstage view"
                            Click="OnOpenBackstage" />
                    </fluent:ApplicationMenu.Items>
                    <fluent:ApplicationMenu.RightPaneContent>
                        <StackPanel Spacing="4" Padding="8">
                            <TextBlock Text="Recent Documents" FontWeight="SemiBold" FontSize="14" Margin="4,4,4,6" />
                            <fluent:RibbonMenuItem Header="Document1.docx" IconGlyph="&#xE8A5;" />
                            <fluent:RibbonMenuItem Header="Report_Q4.docx" IconGlyph="&#xE8A5;" />
                            <fluent:RibbonMenuItem Header="Proposal.docx" IconGlyph="&#xE8A5;" />
                        </StackPanel>
                    </fluent:ApplicationMenu.RightPaneContent>
                    <fluent:ApplicationMenu.FooterPaneContent>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <Button Content="Options" Padding="12,4" />
                            <Button Content="Exit" Padding="12,4" />
                        </StackPanel>
                    </fluent:ApplicationMenu.FooterPaneContent>
                </fluent:ApplicationMenu>
            </fluent:Ribbon.Menu>

            <!-- Contextual Tab Groups -->
            <fluent:Ribbon.ContextualGroups>
                <fluent:RibbonContextualTabGroup x:Name="TableToolsGroup" Header="Table Tools"
                                                 Background="#0F6CBD" Foreground="White"
                                                 Visibility="Collapsed" />
            </fluent:Ribbon.ContextualGroups>

            <!-- Quick Access Toolbar items (mirrored above/below the ribbon) -->
            <fluent:Ribbon.QuickAccessToolBarItems>
                <fluent:RibbonButton Size="Small" IconGlyph="&#xE77F;" ToolTipService.ToolTip="Paste" />
                <fluent:RibbonButton Size="Small" IconGlyph="&#xE8C6;" ToolTipService.ToolTip="Cut" />
                <fluent:RibbonDropDownButton Size="Small" IconGlyph="&#xE7C1;" ToolTipService.ToolTip="Drop-down">
                    <fluent:RibbonDropDownButton.Items>
                        <fluent:RibbonMenuItem Header="Command 1" />
                        <fluent:RibbonMenuItem Header="Command 2" />
                    </fluent:RibbonDropDownButton.Items>
                </fluent:RibbonDropDownButton>
                <fluent:RibbonButton Size="Small" IconGlyph="&#xE80A;" ToolTipService.ToolTip="Gallery" />
                <fluent:RibbonButton Size="Small" IconGlyph="&#xE7A7;" ToolTipService.ToolTip="Undo" />
            </fluent:Ribbon.QuickAccessToolBarItems>

            <!-- Toolbar items shown on the right of the title bar -->
            <fluent:Ribbon.ToolBarItems>
                <fluent:RibbonButton Size="Small" IconGlyph="&#xE946;" ToolTipService.ToolTip="Help" />
                <fluent:RibbonToggleButton Size="Small" IconGlyph="&#xE706;" ToolTipService.ToolTip="Toggle theme" />
            </fluent:Ribbon.ToolBarItems>

            <fluent:Ribbon.Tabs>
                <!-- Toolbars Tab (mirrors the WPF Showcase "Toolbars" landing tab) -->
                <fluent:RibbonTab Header="Toolbars" fluent:KeyTip.Keys="TO"
                                  ReduceOrder="Spinners,Group,Group,WrapPanel,Font,Font,Clipboard,Clipboard,Spinners,Group,WrapPanel,Font,Clipboard">
                    <fluent:RibbonTab.Groups>

                        <!-- Clipboard Group -->
                        <fluent:RibbonGroupBox Header="Clipboard" IconGlyph="&#xE77F;" IsLauncherVisible="True" LauncherClick="OnLauncherClick" fluent:KeyTip.Keys="C">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonSplitButton Header="Paste" Size="Large" IconGlyph="&#xE77F;" fluent:KeyTip.Keys="V">
                                    <fluent:RibbonSplitButton.Items>
                                        <fluent:RibbonMenuItem Header="Keep Source Formatting" IconGlyph="&#xE77F;" />
                                        <fluent:RibbonMenuItem Header="Merge Formatting" IconGlyph="&#xE8D2;" />
                                        <fluent:RibbonMenuItem Header="Keep Text Only" IconGlyph="&#xE8E9;" />
                                        <fluent:RibbonSeparator Orientation="Horizontal" />
                                        <fluent:RibbonMenuItem Header="Paste Special..." />
                                        <fluent:RibbonMenuItem Header="Set Default Paste..." />
                                    </fluent:RibbonSplitButton.Items>
                                    <ToolTipService.ToolTip>
                                        <fluent:ScreenTip Title="Paste (Ctrl+V)" Text="Paste the contents of the clipboard." DisableReason="Copy something first to use Paste." />
                                    </ToolTipService.ToolTip>
                                </fluent:RibbonSplitButton>
                                <fluent:RibbonButton Header="Cut" Size="Medium" IconGlyph="&#xE8C6;" IsEnabled="False" fluent:KeyTip.Keys="X" />
                                <fluent:RibbonButton Header="Copy" Size="Medium" IconGlyph="&#xE8C8;" IsEnabled="False" fluent:KeyTip.Keys="C" />
                                <fluent:RibbonButton Header="Format Painter" Size="Medium" IconGlyph="&#xE790;" fluent:KeyTip.Keys="FP" />
                                <fluent:RibbonDropDownButton Header="DropDown&#x0A;Button" Size="Large" IconGlyph="&#xE7C1;" HasTriangle="True" fluent:KeyTip.Keys="W">
                                    <fluent:RibbonDropDownButton.Items>
                                        <fluent:RibbonMenuItem Header="Confidential" IconGlyph="&#xE72E;" />
                                        <fluent:RibbonMenuItem Header="Do Not Copy" IconGlyph="&#xE72E;" />
                                        <fluent:RibbonMenuItem Header="Draft" IconGlyph="&#xE70F;" />
                                        <fluent:RibbonMenuItem Header="Sample" IconGlyph="&#xE70F;" />
                                        <fluent:RibbonMenuItem Header="Urgent" IconGlyph="&#xE7BA;" />
                                        <fluent:RibbonSeparator Orientation="Horizontal" />
                                        <fluent:RibbonMenuItem Header="Remove Watermark" IconGlyph="&#xE74D;" />
                                    </fluent:RibbonDropDownButton.Items>
                                </fluent:RibbonDropDownButton>
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <!-- Font Group (RibbonToolBar with a two-row layout, like the WPF Font group) -->
                        <fluent:RibbonGroupBox Header="Font" IconGlyph="&#xE8D2;" IsLauncherVisible="True" LauncherClick="OnLauncherClick" fluent:KeyTip.Keys="F">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonToolBar x:Name="FontToolBar">
                                    <fluent:RibbonToolBar.Items>
                                        <fluent:RibbonComboBox x:Name="fontNameCombo" InputWidth="75" />
                                        <fluent:RibbonComboBox
                                            x:Name="fontSizeCombo"
                                            InputWidth="49" />
                                        <fluent:RibbonButton x:Name="btnGrowFont" Size="Small" IconGlyph="&#xE8E8;" ToolTipService.ToolTip="Grow Font" />
                                        <fluent:RibbonButton x:Name="btnShrinkFont" Size="Small" IconGlyph="&#xE8E7;" ToolTipService.ToolTip="Shrink Font" />
                                        <fluent:RibbonDropDownButton x:Name="btnChangeCase" Size="Small" IconGlyph="&#xE97F;" HasTriangle="True" ToolTipService.ToolTip="Change Case">
                                            <fluent:RibbonDropDownButton.Items>
                                                <fluent:RibbonMenuItem Header="UPPERCASE" />
                                                <fluent:RibbonMenuItem Header="lowercase" />
                                                <fluent:RibbonMenuItem Header="Capitalize Each Word" />
                                            </fluent:RibbonDropDownButton.Items>
                                        </fluent:RibbonDropDownButton>
                                        <fluent:RibbonButton x:Name="btnClearFormatting" Size="Small" IconGlyph="&#xE894;" ToolTipService.ToolTip="Clear Formatting" />
                                        <fluent:RibbonToggleButton x:Name="btnBold" Size="Small" IconGlyph="&#xE8DD;" ToolTipService.ToolTip="Bold" />
                                        <fluent:RibbonToggleButton x:Name="btnItalic" Size="Small" IconGlyph="&#xE8DB;" ToolTipService.ToolTip="Italic" />
                                        <fluent:RibbonToggleButton x:Name="btnUnderline" Size="Small" IconGlyph="&#xE8DC;" ToolTipService.ToolTip="Underline" />
                                        <fluent:RibbonButton x:Name="btnStrikethrough" Size="Small" IconGlyph="&#xEDE0;" ToolTipService.ToolTip="Strikethrough" />
                                        <fluent:RibbonButton x:Name="btnSubscript" Size="Small" IconGlyph="&#xE8E6;" ToolTipService.ToolTip="Subscript" />
                                                                                <fluent:RibbonButton x:Name="btnSuperscript" Size="Small" IconGlyph="&#xE8E9;" ToolTipService.ToolTip="Superscript" />
                                        <fluent:RibbonDropDownButton x:Name="btnTextEffects" Size="Small" IconGlyph="&#xE8D2;" HasTriangle="True" ToolTipService.ToolTip="Text Effects">
                                            <fluent:RibbonDropDownButton.Items>
                                                <fluent:ColorGallery Columns="10" IsAutomaticColorButtonVisible="True" />
                                            </fluent:RibbonDropDownButton.Items>
                                        </fluent:RibbonDropDownButton>
                                        <fluent:RibbonDropDownButton x:Name="btnHighlight" Size="Small" IconGlyph="&#xE7E6;" HasTriangle="True" ToolTipService.ToolTip="Text Highlight Color">
                                            <fluent:RibbonDropDownButton.Items>
                                                <fluent:ColorGallery Columns="10" IsNoColorButtonVisible="True" />
                                            </fluent:RibbonDropDownButton.Items>
                                        </fluent:RibbonDropDownButton>
                                        <fluent:RibbonDropDownButton x:Name="btnFontColor" Size="Small" IconGlyph="&#xE790;" HasTriangle="True" ToolTipService.ToolTip="Font Color">
                                            <fluent:RibbonDropDownButton.Items>
                                                <fluent:ColorGallery Columns="10" IsAutomaticColorButtonVisible="True" IsNoColorButtonVisible="True" />
                                            </fluent:RibbonDropDownButton.Items>
                                        </fluent:RibbonDropDownButton>
                                    </fluent:RibbonToolBar.Items>
                                    <fluent:RibbonToolBar.LayoutDefinitions>
                                        <fluent:RibbonToolBarLayoutDefinition RowCount="2">
                                            <fluent:RibbonToolBarLayoutDefinition.Rows>
                                                <fluent:RibbonToolBarRow>
                                                    <fluent:RibbonToolBarRow.Children>
                                                        <fluent:RibbonToolBarControlGroupDefinition>
                                                            <fluent:RibbonToolBarControlGroupDefinition.Children>
                                                                <fluent:RibbonToolBarControlDefinition Target="fontNameCombo" Width="110" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="fontSizeCombo" Width="64" Size="Small" />
                                                            </fluent:RibbonToolBarControlGroupDefinition.Children>
                                                        </fluent:RibbonToolBarControlGroupDefinition>
                                                        <fluent:RibbonToolBarControlGroupDefinition>
                                                            <fluent:RibbonToolBarControlGroupDefinition.Children>
                                                                <fluent:RibbonToolBarControlDefinition Target="btnGrowFont" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnShrinkFont" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnChangeCase" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnClearFormatting" Size="Small" />
                                                            </fluent:RibbonToolBarControlGroupDefinition.Children>
                                                        </fluent:RibbonToolBarControlGroupDefinition>
                                                    </fluent:RibbonToolBarRow.Children>
                                                </fluent:RibbonToolBarRow>
                                                <fluent:RibbonToolBarRow>
                                                    <fluent:RibbonToolBarRow.Children>
                                                        <fluent:RibbonToolBarControlGroupDefinition>
                                                            <fluent:RibbonToolBarControlGroupDefinition.Children>
                                                                <fluent:RibbonToolBarControlDefinition Target="btnBold" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnItalic" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnUnderline" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnStrikethrough" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnSubscript" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnSuperscript" Size="Small" />
                                                            </fluent:RibbonToolBarControlGroupDefinition.Children>
                                                        </fluent:RibbonToolBarControlGroupDefinition>
                                                        <fluent:RibbonToolBarControlGroupDefinition>
                                                            <fluent:RibbonToolBarControlGroupDefinition.Children>
                                                                <fluent:RibbonToolBarControlDefinition Target="btnTextEffects" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnHighlight" Size="Small" />
                                                                <fluent:RibbonToolBarControlDefinition Target="btnFontColor" Size="Small" />
                                                            </fluent:RibbonToolBarControlGroupDefinition.Children>
                                                        </fluent:RibbonToolBarControlGroupDefinition>
                                                    </fluent:RibbonToolBarRow.Children>
                                                </fluent:RibbonToolBarRow>
                                            </fluent:RibbonToolBarLayoutDefinition.Rows>
                                        </fluent:RibbonToolBarLayoutDefinition>
                                    </fluent:RibbonToolBar.LayoutDefinitions>
                                </fluent:RibbonToolBar>
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <!-- WrapPanel Group -->
                        <fluent:RibbonGroupBox Header="WrapPanel" IconGlyph="&#xE8A9;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonButton Header="Green" Size="Medium" IconGlyph="&#xE91F;" Foreground="#13A10E" />
                                <fluent:RibbonButton Header="Gray" Size="Medium" IconGlyph="&#xE91F;" Foreground="#9E9E9E" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <!-- Group (RibbonToolBar with a spinner row over stacked color buttons) -->
                        <fluent:RibbonGroupBox Header="Group" IconGlyph="&#xE8A9;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonToolBar x:Name="ColorToolBar">
                                    <fluent:RibbonToolBar.Items>
                                        <fluent:RibbonSpinner x:Name="groupSpinner" Value="0" Minimum="0" Maximum="100" Increment="1" InputWidth="90" />
                                        <fluent:RibbonButton x:Name="btnGreen" Header="Green" Size="Small" IconGlyph="&#xE91F;" Foreground="#13A10E" />
                                        <fluent:RibbonButton x:Name="btnGray" Header="Gray" Size="Small" IconGlyph="&#xE91F;" Foreground="#9E9E9E" />
                                        <fluent:RibbonButton x:Name="btnYellow" Header="Yellow" Size="Small" IconGlyph="&#xE91F;" Foreground="#FFB900" />
                                        <fluent:RibbonButton x:Name="btnBrown" Header="Brown" Size="Small" IconGlyph="&#xE91F;" Foreground="#A0522D" />
                                    </fluent:RibbonToolBar.Items>
                                    <fluent:RibbonToolBar.LayoutDefinitions>
                                        <fluent:RibbonToolBarLayoutDefinition RowCount="2">
                                            <fluent:RibbonToolBarLayoutDefinition.Rows>
                                                <fluent:RibbonToolBarRow>
                                                    <fluent:RibbonToolBarRow.Children>
                                                        <fluent:RibbonToolBarControlDefinition Target="groupSpinner" Width="120" />
                                                    </fluent:RibbonToolBarRow.Children>
                                                </fluent:RibbonToolBarRow>
                                                <fluent:RibbonToolBarRow>
                                                    <fluent:RibbonToolBarRow.Children>
                                                        <fluent:RibbonToolBarControlDefinition Target="btnGreen" Size="Small" />
                                                        <fluent:RibbonToolBarControlDefinition Target="btnGray" Size="Small" />
                                                        <fluent:RibbonToolBarControlDefinition Target="btnYellow" Size="Small" />
                                                        <fluent:RibbonToolBarControlDefinition Target="btnBrown" Size="Small" />
                                                    </fluent:RibbonToolBarRow.Children>
                                                </fluent:RibbonToolBarRow>
                                            </fluent:RibbonToolBarLayoutDefinition.Rows>
                                        </fluent:RibbonToolBarLayoutDefinition>
                                    </fluent:RibbonToolBar.LayoutDefinitions>
                                </fluent:RibbonToolBar>
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <!-- Spinners Group -->
                        <fluent:RibbonGroupBox Header="Spinners" IconGlyph="&#xE8EF;" IsLauncherVisible="True" LauncherClick="OnLauncherClick" fluent:KeyTip.Keys="ZXB">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonSpinner Header="Left:" IconGlyph="&#xE8EF;" Value="1" Minimum="0" Maximum="1000" Increment="1" Format="0 px" InputWidth="75" IsEnabled="False" />
                                <fluent:RibbonSpinner Header="Right:" IconGlyph="&#xE8EF;" Value="1" Minimum="0" Maximum="1000" Increment="1" Format="0 px" InputWidth="75" SelectAllTextOnFocus="True" />
                                <fluent:RibbonSpinner Header="Top:" IconGlyph="&#xE8EF;" Value="0" Minimum="0" Maximum="1000" Increment="1" Format="0 px" InputWidth="75" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                    </fluent:RibbonTab.Groups>
                </fluent:RibbonTab>

                <!-- Insert Tab (faithful clone of WPF Showcase "Insert") -->
                <fluent:RibbonTab Header="Insert" fluent:KeyTip.Keys="I"
                                  ReduceOrder="groupLL, groupLL, groupLL">
                    <fluent:RibbonTab.Groups>
                        <fluent:RibbonGroupBox x:Name="groupLL" Header="Fonts" IconGlyph="&#xE8D2;"
                                               IsLauncherVisible="False" fluent:KeyTip.Keys="FG">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonComboBox x:Name="insertFontsCombo1" Header="Fonts"
                                                       IconGlyph="&#xE8D2;" InputWidth="120" fluent:KeyTip.Keys="FD" />
                                <fluent:RibbonComboBox x:Name="insertFontsCombo2" Header="Fonts" InputWidth="120" />
                                <fluent:RibbonButton Header="Add item to fonts" Size="Medium"
                                                     IconGlyph="&#xE710;" Click="HandleAddItemToFontsClick" />
                                <fluent:RibbonComboBox x:Name="insertKbNav1" Header="KeyboardNavigation" fluent:KeyTip.Keys="KET" />
                                <fluent:RibbonComboBox x:Name="insertKbNav2" Header="KeyboardNavigation" fluent:KeyTip.Keys="KEF" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <fluent:RibbonGroupBox Header="Gallery" IconGlyph="&#xE7BA;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:InRibbonGallery x:Name="InsertSplitGallery" Header="Split"
                                                        Width="100" IconGlyph="&#xE7BA;" ItemHeight="55" ItemWidth="40"
                                                        fluent:KeyTip.Keys="S" MaxItemsInRow="2" MinItemsInRow="2" />
                                <fluent:InRibbonGallery x:Name="InsertManyItemsGallery" Header="Many items"
                                                        IsCollapsed="True" ItemHeight="100" ItemWidth="100"
                                                        MaxDropDownItemsInRow="5" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <fluent:RibbonGroupBox Header="Buttons" IconGlyph="&#xE8D2;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonButton Header="Enlarge" Size="Large" IconGlyph="&#xE710;" Click="OnEnlargeClick" />
                                <fluent:RibbonButton Header="Reduce" Size="Large" IconGlyph="&#xE738;" Click="OnReduceClick" />
                                <fluent:RibbonButton Header="Button with rectangle as icon" Size="Large"
                                                     IconGlyph="&#xE71A;" Foreground="#107C10" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <fluent:RibbonGroupBox Header="Test" IconGlyph="&#xE7A7;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonSplitButton x:Name="UndoButton" Header="Undo" Size="Medium"
                                                          IconGlyph="&#xE7A7;" fluent:KeyTip.Keys="Z">
                                    <fluent:RibbonSplitButton.Items>
                                        <fluent:RibbonMenuItem Header="My header" Description="Test" IconGlyph="&#xE73B;" />
                                        <fluent:RibbonMenuItem Header="Undo something" IconGlyph="&#xE7A7;" />
                                        <fluent:RibbonMenuItem Header="Undo another thing" />
                                    </fluent:RibbonSplitButton.Items>
                                </fluent:RibbonSplitButton>
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>
                    </fluent:RibbonTab.Groups>
                </fluent:RibbonTab>

                <!-- Tests Tab (faithful clone of WPF Showcase "Tests") -->
                <fluent:RibbonTab Header="Tests" fluent:KeyTip.Keys="TE">
                    <fluent:RibbonTab.Groups>
                        <fluent:RibbonGroupBox Header="LongLongGroup" IsLauncherVisible="False">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonCheckBox Header="Text 1" IsThreeState="True" />
                                <fluent:RibbonCheckBox Header="Text 2" IsChecked="True" IsEnabled="False" />
                                <fluent:RibbonCheckBox Header="Text 3" IsEnabled="False" />
                                <fluent:RibbonCheckBox Header="Text 4" IsThreeState="True" IsEnabled="False" />
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <fluent:RibbonGroupBox Header="DropDownButtons" IconGlyph="&#xE787;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonDropDownButton Header="Calendar" Size="Large" IconGlyph="&#xE787;">
                                    <fluent:RibbonDropDownButton.Items>
                                        <fluent:RibbonMenuItem Header="Today" IconGlyph="&#xE8BF;" />
                                        <fluent:RibbonMenuItem Header="Tomorrow" />
                                        <fluent:RibbonMenuItem Header="Pick a date..." />
                                    </fluent:RibbonDropDownButton.Items>
                                </fluent:RibbonDropDownButton>
                                <fluent:RibbonDropDownButton Header="Bound items" Size="Large" IconGlyph="&#xE762;">
                                    <fluent:RibbonDropDownButton.Items>
                                        <fluent:RibbonMenuItem Header="Item 1" />
                                        <fluent:RibbonMenuItem Header="Item 2" />
                                        <fluent:RibbonMenuItem Header="Item 3" />
                                    </fluent:RibbonDropDownButton.Items>
                                </fluent:RibbonDropDownButton>
                                <fluent:RibbonDropDownButton Header="Dropdown (auto close on click)" Size="Large" IconGlyph="&#xE762;">
                                    <fluent:RibbonDropDownButton.Items>
                                        <fluent:RibbonMenuItem Header="Item 1">
                                            <fluent:RibbonMenuItem.Items>
                                                <fluent:RibbonMenuItem Header="Item 1" />
                                                <fluent:RibbonMenuItem Header="Item 2" />
                                                <fluent:RibbonMenuItem Header="Item 3" />
                                            </fluent:RibbonMenuItem.Items>
                                        </fluent:RibbonMenuItem>
                                        <fluent:RibbonMenuItem Header="Item 2" />
                                        <fluent:RibbonMenuItem Header="Item 3" />
                                        <fluent:RibbonMenuItem Header="Item 4" />
                                        <fluent:RibbonMenuItem Header="Item 5" />
                                    </fluent:RibbonDropDownButton.Items>
                                </fluent:RibbonDropDownButton>
                            </fluent:RibbonGroupBox.Items>
                        </fluent:RibbonGroupBox>

                        <fluent:RibbonGroupBox Header="Vector images" IconGlyph="&#xF156;">
                            <fluent:RibbonGroupBox.Items>
                                <fluent:RibbonSplitButton Header="Large" Size="Large" IconGlyph="&#xF156;" fluent:KeyTip.Keys="L" />
                                <fluent:RibbonSplitButton Header="Medium" Size="Medium" IconGlyph="&#xF156;" fluent:KeyTip.Keys="M" />
                                <fluent:RibbonSplitButton Header="Small" Size="Small" IconGlyph="&#xF156;" fluent:KeyTip.Keys="S" />
                                <fluent:RibbonSplitButton Header="Large" Size="Large" IconGlyph="&#xF156;" IsEnabled="False" />
