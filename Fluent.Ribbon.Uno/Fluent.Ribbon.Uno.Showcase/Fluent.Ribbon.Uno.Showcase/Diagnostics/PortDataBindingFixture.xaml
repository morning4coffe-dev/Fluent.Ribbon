<UserControl
    x:Class="FluentRibbon.Uno.Showcase.Diagnostics.PortDataBindingFixture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="using:Fluent">
    <UserControl.Resources>
        <DataTemplate x:Key="PrimaryItemTemplate">
            <TextBlock Text="{Binding Title}" Tag="PortDataPrimary" />
        </DataTemplate>
        <DataTemplate x:Key="AlternateItemTemplate">
            <TextBlock Text="{Binding Title}" Tag="PortDataAlternate" />
        </DataTemplate>
        <DataTemplate x:Key="GroupItemTemplate">
            <fluent:Button Header="{Binding Title}" Tag="PortDataGroup" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="CustomItemsPanel">
            <StackPanel Orientation="Horizontal" Spacing="7" Tag="PortDataItemsPanel" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="4">
        <fluent:MenuItem
            x:Name="DataMenu"
            Header="Bound menu"
            ItemsSource="{Binding Items}"
            ItemTemplate="{StaticResource PrimaryItemTemplate}" />
        <fluent:StatusBar
            x:Name="DataStatus"
            ItemsSource="{Binding Items}"
            ItemTemplate="{StaticResource PrimaryItemTemplate}" />
        <fluent:RibbonGroupBox
            x:Name="DataGroup"
            Header="Bound group"
            Height="100"
            ItemsSource="{Binding Items}"
            ItemTemplate="{StaticResource GroupItemTemplate}" />
        <fluent:Gallery
            x:Name="DataGallery"
            Width="400"
            Height="100"
            ItemsSource="{Binding Items}"
            ItemTemplate="{StaticResource PrimaryItemTemplate}"
            SelectedItem="{Binding Selected, Mode=TwoWay}" />
        <fluent:InRibbonGallery
            x:Name="DataInlineGallery"
            Width="400"
            Height="64"
            ItemsSource="{Binding Items}"
            ItemTemplate="{StaticResource PrimaryItemTemplate}" />
    </StackPanel>
</UserControl>
